{
  "name": "agentic-blog",
  "version": "0.1.0",
  "private": true,
  "description": "A blog where every post starts as a raw voice note and every version links back to it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "site",
    "agents",
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "build": "npm run check:why && npm run build --workspace site",
    "preview": "npm run preview --workspace site",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,mjs,astro,css,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,astro,css,json,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.roadbook.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "check:why": "tsx scripts/check-why.ts",
    "roadbook": "tsx packages/cli/src/main.ts",
    "live:rebuild": "tsx scripts/live-runs.ts",
    "agent": "npm run agent --workspace agents --",
    "dev:fresh": "npm run dev:fresh --workspace site",
    "pitch:voice": "tsx --env-file=site/.env.local scripts/pitch/voice.ts",
    "tour:voice": "tsx --env-file=site/.env.local scripts/tour-voice.ts",
    "tour:screens": "tsx scripts/tour-screens.ts",
    "pr:shots": "tsx scripts/pr-shots.ts",
    "ask:eval": "tsx scripts/ask-eval.ts",
    "pitch": "tsx scripts/pitch/record.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "undici@7": "7.30.1"
  }
}

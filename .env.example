# Why: the keys a local run needs, with no values, so the next person knows what to set.
# Copy to .env and fill in. The site's worker secret lives in site/.dev.vars instead.
ANTHROPIC_API_KEY=

# The studio shows a run while it happens when the runner can reach it. Leave STUDIO_URL empty to send nothing.
# Locally, against npm run worker:dev: STUDIO_URL=http://localhost:8787 and no token (Access is skipped there).
# Against the live site: STUDIO_URL=https://blog.victorsaly.com and an Access service token's id and secret.
STUDIO_URL=
STUDIO_ACCESS_CLIENT_ID=
STUDIO_ACCESS_CLIENT_SECRET=

---
// Why: the door into the studio. Most visits are to say something new, so that is the one big thing here,
// and one press starts the recording; beside it, what is waiting for Victor, each as a number that opens its
// area: the agents' writing to read, readers' comments to decide, and what this month has cost against the
// budget. Review and money are as of the last deploy; comments are counted when the page opens, since
// readers write at any time, and when they cannot be counted the page says so rather than guess. Below them,
// what the agents are waiting on (holds that stand, questions), read live like the Agents board.
import Studio from '../../layouts/Studio.astro';
import { loadCosted, loadWaiting } from '../../lib/studio-data';
import { moneyOf, shareOfCap, spendIn } from '../../lib/how-made';
import { formatDate } from '../../lib/content';
import { settings } from '../../lib/settings';
import { MicIcon } from '../../islands/MicIcon';
import { AgentsWaiting } from '../../islands/AgentsWaiting';
import project from '../../../../roadbook.config';

const waiting = await loadWaiting();
const files = waiting.reduce((sum, t) => sum + t.waiting.length, 0);
const thoughts = waiting.filter((t) => t.waiting.length > 0).length;

const builtAt = new Date();
const { show, per_usd: perUsd } = settings.publishing.currency;
const money = (usd: number): string => moneyOf(usd, { show, perUsd });
const costed = await loadCosted();
const titles = Object.fromEntries(costed.map((t) => [t.slug, t.title]));
const month = spendIn(
  costed.flatMap((t) => t.rows),
  builtAt.toISOString().slice(0, 7),
);
const cap = project.budget.monthlyCapUsd;
const plural = (n: number, one: string, many: string): string => (n === 1 ? one : many);
---

<Studio description="A private room to talk in.">
  <h1>Today</h1>

  <div class="today">
    <div class="start">
      <a class="say-it" href="/studio/talk?start=1">
        <MicIcon />
        Say it
      </a>
      <p class="small quiet">
        Talk. Don't tidy. Already written down? <a href="/studio/talk">Paste it instead</a>.
      </p>
    </div>

    <section aria-labelledby="waiting-label">
      <h2 class="label" id="waiting-label">Waiting for you</h2>
      <ul class="waiting">
        <li>
          <a href="/studio/review">
            <span class="number">{files}</span>
            <span class="what">
              {plural(files, 'file', 'files')} to review
              <span class="quiet">
                {
                  files === 0
                    ? 'nothing the agents wrote is unread'
                    : `in ${String(thoughts)} ${plural(thoughts, 'thought', 'thoughts')}`
                }
              </span>
            </span>
          </a>
        </li>
        <li>
          <a href="/studio/comments">
            <span class="number" data-today-comments>…</span>
            <span class="what">
              comments to decide
              <span class="quiet" data-today-comments-note>counting…</span>
            </span>
          </a>
        </li>
        <li>
          <a href="/studio/runs">
            <span class="number">{money(month.usd)}</span>
            <span class="what">
              spent this month
              <span class="quiet">
                {month.isFloor ? 'at least; ' : ''}{shareOfCap(month.usd, cap)} of {money(cap)}, as
                of{' '}
                {formatDate(builtAt)}
              </span>
            </span>
          </a>
        </li>
      </ul>
      <AgentsWaiting client:load titles={titles} />
    </section>
  </div>
</Studio>

<script>
  import { COMMENTS_CHANGED } from '../../lib/studio-areas';

  const cell = document.querySelector<HTMLElement>('[data-today-comments]');
  const note = document.querySelector<HTMLElement>('[data-today-comments-note]');
  async function count(): Promise<void> {
    if (!cell || !note) return;
    let pending: unknown = null;
    try {
      const response = await fetch('/api/comments/count');
      const data: unknown = await response.json();
      if (response.ok && typeof data === 'object' && data !== null)
        pending = (data as { pending?: unknown }).pending;
    } catch {
      /* said below */
    }
    if (typeof pending === 'number') {
      cell.textContent = String(pending);
      note.textContent = `counted at ${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}`;
    } else {
      cell.textContent = '?';
      note.textContent = 'could not be counted; open Comments to see why';
    }
  }
  void count();
  window.addEventListener(COMMENTS_CHANGED, () => void count());
</script>

<style>
  .today {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 60rem) {
    .today {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  .start {
    display: grid;
    gap: var(--space-2);
  }
  .start p {
    margin: 0;
  }
  .waiting {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  @media (min-width: 40rem) {
    .waiting {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .waiting li + li {
      border-left: var(--rule-width) solid var(--rule);
    }
  }
  .waiting li {
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .waiting a {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .waiting a:hover {
      background: var(--hover);
    }
    .waiting a:hover .what {
      text-decoration: underline;
    }
  }
  .number {
    font-size: var(--size-title);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
  }
  .what {
    display: grid;
    font-weight: 700;
  }
  .what .quiet {
    font-weight: 400;
    font-size: var(--size-small);
  }
  section :global(.agents-waiting) {
    margin-top: var(--space-4);
  }
  section :global(.agents-waiting p) {
    margin: 0 0 var(--space-2);
  }
</style>

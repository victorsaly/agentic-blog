---
// Why: what the agents wrote that Victor has not read yet, so nothing waits unseen. Drafts are included: the
// structure agent opens every thought as a draft, and its versions wait for review then.
import Studio from '../../layouts/Studio.astro';
import { ReviewList } from '../../islands/ReviewList';
import { loadWaiting } from '../../lib/studio-data';

const waiting = await loadWaiting();
---

<Studio description="What the agents wrote that you have not read yet.">
  <section class="review" aria-labelledby="review-label">
    <h1 id="review-label">Waiting for your review</h1>
    <ReviewList client:load waiting={waiting} />
  </section>
</Studio>

<style is:global>
  .review-list > p {
    margin-top: var(--space-3);
  }
  .review .thought {
    margin: var(--space-4) 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .review .thought legend {
    padding: 0;
    font-weight: 700;
  }
  .review .thought > ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    max-width: none;
  }
  .review .thought > ul > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    padding-block: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .review .thought input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--ink);
  }
  .review .thought label {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .review .thought code {
    color: var(--quiet);
    overflow-wrap: anywhere;
  }
  .review .read {
    font-size: var(--size-small);
  }
  /* The player takes its own row under the file it plays, so the row's columns stay as they are. */
  .review .listen {
    grid-column: 2 / -1;
    width: 100%;
    max-width: var(--measure);
  }
  .review .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .review .status {
    min-height: 1.6em;
    margin-top: var(--space-2);
  }
  /* A file read in place opens under its row, at reading width; the toggle is a plain disclosure. */
  .review .read-here {
    grid-column: 1 / -1;
    margin-top: var(--space-2);
  }
  .review .read-here > summary {
    cursor: pointer;
    font-weight: 700;
  }
  .review .read-here > .markdown {
    margin-top: var(--space-2);
    padding-left: var(--space-3);
    border-left: var(--rule-strong) solid var(--ink);
  }
</style>

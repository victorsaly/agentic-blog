---
// Why: one run's own page, so a run can be opened, kept open while it happens, and linked to. The site is
// built ahead of time, so the run is named in the address (?id=) and the page reads it in the browser.
import Studio from '../../../layouts/Studio.astro';
import { RunTimeline } from '../../../islands/RunTimeline';
import { loadCosted } from '../../../lib/studio-data';
import { settings } from '../../../lib/settings';

const titles = Object.fromEntries((await loadCosted()).map((t) => [t.slug, t.title]));
const { show, per_usd: perUsd } = settings.publishing.currency;
---

<Studio description="One agent run, event for event, while it happens.">
  <RunTimeline client:load titles={titles} currency={{ show, perUsd }} />
</Studio>

<style is:global>
  .run-page h1 a {
    color: inherit;
  }
  .run-page .summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }
  .run-page .clock {
    font-size: var(--size-message);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .run-page .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-5);
  }
  .run-page .facts dt {
    font-weight: 700;
  }
  .run-page .facts dd {
    margin: 0;
  }
  .timeline {
    list-style: none;
    margin: var(--space-3) 0 var(--space-5);
    padding: 0;
    max-width: none;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .timeline .at {
    font-variant-numeric: tabular-nums;
  }
  .timeline .told {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    max-width: var(--measure);
  }
  .timeline .detail {
    overflow-wrap: anywhere;
  }
  .timeline .streamed {
    white-space: pre-wrap;
  }
  /* A waiting gate's answer sits under the summary, opened by a strong rule like every section. */
  .gate-answer {
    margin: 0 0 var(--space-5);
  }
  .gate-answer .question {
    font-size: var(--size-message);
    font-weight: 700;
    max-width: var(--measure);
  }
  .gate-answer .context {
    margin: var(--space-3) 0;
    max-width: var(--measure);
    border-left: var(--rule-strong) solid var(--ink);
    padding-left: var(--space-3);
  }
  .gate-answer .context > summary {
    cursor: pointer;
    font-weight: 700;
  }
  .gate-answer .context-text {
    margin-top: var(--space-2);
    white-space: pre-wrap;
  }
  .gate-answer form,
  .gate-answer .decide {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-3);
  }
  .gate-answer .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

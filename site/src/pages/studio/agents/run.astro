---
// Why: one run's own page, so a run can be opened, kept open while it happens, and linked to. The site is
// built ahead of time, so the run is named in the address (?id=) and the page reads it in the browser.
import Studio from '../../../layouts/Studio.astro';
import { RunTimeline } from '../../../islands/RunTimeline';
import { loadCosted } from '../../../lib/studio-data';
import { settings } from '../../../lib/settings';
import { layoutOf } from '@roadbook/core/route';
import { allowanceOf } from '../../../lib/run-again';
import project from '../../../../../roadbook.config';

const costed = await loadCosted();
const titles = Object.fromEntries(costed.map((t) => [t.slug, t.title]));
const workflow = project.workflows.find((w) => w.id === 'blog-post');
const layout = workflow ? layoutOf(workflow) : { steps: [], edges: [], columns: 0, rows: 0 };
const builtStates = Object.fromEntries(costed.map((t) => [t.slug, t.states]));
// What one run of each agent and guard may cost, by its card, for Run again.
const allowances = Object.fromEntries(
  workflow
    ? Object.keys(workflow.nodes).flatMap((id) => {
        const usd = allowanceOf(workflow, id);
        return usd === null ? [] : [[id, usd]];
      })
    : [],
);
const { show, per_usd: perUsd } = settings.publishing.currency;
---

<Studio description="One agent run, event for event, while it happens.">
  <RunTimeline
    client:load
    titles={titles}
    currency={{ show, perUsd }}
    layout={layout}
    builtStates={builtStates}
    allowances={allowances}
  />
</Studio>

<style is:global>
  .run-page h1 a {
    color: inherit;
  }
  .run-page .summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }
  .run-page .clock {
    font-size: var(--size-message);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  /* The route's key closes its section; the timeline opens a new one, with room between. */
  .run-page .route-key {
    margin-bottom: var(--space-5);
  }
  /* A gate waiting on Victor says since when, at reading size: it is not a clock running against him. */
  .run-page .since {
    color: var(--quiet);
  }
  /* The record's facts wait behind Details, at the foot, so the decision comes first. */
  .run-page .facts-more {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-2);
    border-top: var(--rule-width) solid var(--rule);
  }
  .run-page .facts-more > summary {
    min-height: var(--tap);
    padding-block: 0.6rem;
    cursor: pointer;
    font-weight: 700;
  }
  /* A run's own words, kept when a line puts them plainly. */
  .timeline .raw {
    margin-top: var(--space-1);
  }
  .timeline .raw > summary {
    cursor: pointer;
    color: var(--quiet);
  }
  .timeline .raw code {
    display: block;
    margin-top: var(--space-1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .run-page .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-5);
  }
  .run-page .facts dt {
    font-weight: 700;
  }
  .run-page .facts dd {
    margin: 0;
  }
  .timeline {
    list-style: none;
    margin: var(--space-3) 0 var(--space-5);
    padding: 0;
    max-width: none;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .timeline .at {
    font-variant-numeric: tabular-nums;
  }
  .timeline .told {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    max-width: var(--measure);
  }
  .timeline .detail {
    overflow-wrap: anywhere;
  }
  .timeline .streamed {
    white-space: pre-wrap;
  }
  /* A waiting gate's answer sits under the summary, opened by a strong rule like every section. */
  .run-again {
    margin: 0 0 var(--space-5);
  }
  .run-again p {
    margin: 0 0 var(--space-2);
  }
  .gate-answer {
    margin: 0 0 var(--space-5);
  }
  .gate-answer .question {
    font-size: var(--size-message);
    font-weight: 700;
    max-width: var(--measure);
  }
  .gate-answer .context {
    margin: var(--space-3) 0;
    max-width: var(--measure);
    border-left: var(--rule-strong) solid var(--ink);
    padding-left: var(--space-3);
  }
  .gate-answer .context > summary {
    cursor: pointer;
    font-weight: 700;
  }
  .gate-answer .context-text {
    margin-top: var(--space-2);
  }
  .gate-answer form,
  .gate-answer .decide {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-3);
  }
  .gate-answer .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

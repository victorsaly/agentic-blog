---
// Why: the agents at work, in one place, with one answer. On top, what waits on Victor (a question, or a
// hold) and what runs now, read from the live copy the runner fills event by event, with GitHub's log and pull
// request on a running row. Then every thought on its route: its line is read from the route (gates included),
// so the line, the picture and the tab row never disagree, and a thought with work going on shows its route
// open, marigold where it works. What finished, and GitHub's own list, wait behind one press; the full grid of
// every agent against every thought behind another. All start from the ledgers as of the last deploy and are
// brought up to date from the live copy; one feed on the page reads it for everything.
import Studio from '../../layouts/Studio.astro';
import { AgentsLive } from '../../islands/AgentsLive';
import { RunsBoard } from '../../islands/RunsBoard';
import { settings } from '../../lib/settings';
import { loadCosted } from '../../lib/studio-data';
import { PipelineLive } from '../../islands/PipelineLive';
import { inOrder, pipelineOf } from '../../lib/pipeline';
import type { AgentCardFacts } from '../../lib/agents';
import { layoutOf } from '@roadbook/core/route';
import project from '../../../../roadbook.config';

const cards = import.meta.glob<AgentCardFacts>('../../../../agents/*/card.ts', {
  import: 'card',
  eager: true,
});
const agents = inOrder(Object.values(cards).map(({ name, phase }) => ({ name, phase })));
const costed = await loadCosted();
const rows = pipelineOf(costed, agents);
const titles = Object.fromEntries(costed.map((t) => [t.slug, t.title]));
// The route is the workflow's, laid out once; each thought's states fill it.
const workflow = project.workflows.find((w) => w.id === 'blog-post');
const layout = workflow ? layoutOf(workflow) : { steps: [], edges: [], columns: 0, rows: 0 };
const builtStates = Object.fromEntries(costed.map((t) => [t.slug, t.states]));

const { show, per_usd: perUsd } = settings.publishing.currency;
---

<Studio description="What the agents are doing, and where each thought stands.">
  <h1>Agents</h1>
  <RunsBoard client:load titles={titles} currency={{ show, perUsd }} builtStates={builtStates} />

  <PipelineLive
    client:load
    rows={rows}
    agents={agents}
    builtAt={new Date().toISOString()}
    layout={layout}
    builtStates={builtStates}
  />

  <details class="earlier">
    <summary class="control">Earlier runs, and GitHub's own list</summary>
    <RunsBoard
      client:load
      titles={titles}
      currency={{ show, perUsd }}
      part="earlier"
      builtStates={builtStates}
    />
    <div class="on-github">
      <AgentsLive client:load titles={titles} summary={false} />
    </div>
  </details>
</Studio>

<style>
  /* What finished, and GitHub's own list of the same runs, wait behind one press: the page above already
     says what runs now, once. */
  .earlier {
    margin-top: var(--space-6);
  }
  .earlier > summary {
    display: inline-flex;
    list-style: none;
    cursor: pointer;
  }
  .earlier > summary::-webkit-details-marker {
    display: none;
  }
  .earlier[open] > summary {
    background: var(--ink);
    color: var(--paper);
  }
  .on-github {
    margin-top: var(--space-6);
  }
  .on-github :global(.summary) {
    font-size: var(--size-body);
  }
</style>

<style is:global>
  /* The pipeline is drawn by an island, so its look is global, kept under .pipeline. */
  .pipeline .standings {
    margin-top: var(--space-3);
  }
  .pipeline .every-agent {
    margin-top: var(--space-4);
  }
  .pipeline .every-agent > summary {
    display: inline-flex;
    list-style: none;
    cursor: pointer;
  }
  .pipeline .every-agent > summary::-webkit-details-marker {
    display: none;
  }
  .pipeline .every-agent[open] > summary {
    background: var(--ink);
    color: var(--paper);
  }
  /* Positioned, so the hidden "Not run" words inside it are measured against it and not the page. */
  .pipeline .scroll {
    position: relative;
    overflow-x: auto;
    margin-top: var(--space-3);
  }
  .pipeline .scroll:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  .pipeline table {
    width: 100%;
    max-width: none;
    border-collapse: collapse;
  }
  .pipeline th,
  .pipeline td {
    padding: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }
  .pipeline thead th {
    font-weight: 700;
  }
  /* The phase row stands on one strong rule, the corner included, so the head reads as one line. */
  .pipeline thead tr:first-child > * {
    border-bottom: var(--rule-strong) solid var(--ink);
  }
  .pipeline .phase {
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .pipeline .opens {
    border-left: var(--rule-width) solid var(--ink);
  }
  .pipeline tbody th {
    font-weight: 400;
    white-space: normal;
    min-width: 12rem;
  }
  .pipeline .none {
    color: var(--quiet);
  }
  .pipeline .when {
    display: block;
    margin-top: var(--space-1);
  }
</style>

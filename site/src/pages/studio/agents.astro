---
// Why: the agents at work, in one place. On top, every run as it happens, wherever it runs, read from the
// live copy the runner fills event by event; each opens on its timeline. Then what GitHub has queued and
// running, with logs and pull requests. Below, where every thought stands, one line each: what stops it (a
// guard's hold, or an agent that did not finish), its latest run, and how many agents have worked on it. That
// line is the decision; the full grid of every agent against every thought is behind one press. Both start
// from the ledgers as of the last deploy and are brought up to date from the live copy (PipelineLive). One
// feed on the page reads the live runs for the board and the pipeline alike.
import Studio from '../../layouts/Studio.astro';
import { AgentsLive } from '../../islands/AgentsLive';
import { RunsBoard } from '../../islands/RunsBoard';
import { settings } from '../../lib/settings';
import { loadCosted } from '../../lib/studio-data';
import { PipelineLive } from '../../islands/PipelineLive';
import { inOrder, pipelineOf } from '../../lib/pipeline';
import { phases, type AgentCardFacts } from '../../lib/agents';

const cards = import.meta.glob<AgentCardFacts>('../../../../agents/*/card.ts', {
  import: 'card',
  eager: true,
});
const agents = inOrder(Object.values(cards).map(({ name, phase }) => ({ name, phase })));
const costed = await loadCosted();
const rows = pipelineOf(costed, agents);
const titles = Object.fromEntries(costed.map((t) => [t.slug, t.title]));

const { show, per_usd: perUsd } = settings.publishing.currency;
---

<Studio description="What the agents are doing, and where each thought stands.">
  <h1>Agents</h1>
  <RunsBoard client:load titles={titles} currency={{ show, perUsd }} />
  <div class="on-github">
    <AgentsLive client:load titles={titles} />
  </div>

  <PipelineLive
    client:load
    rows={rows}
    agents={agents}
    phaseNames={phases}
    builtAt={new Date().toISOString()}
  />
</Studio>

<style>
  /* GitHub's own list comes second, so its summary is said at reading size, not as the page's lead. */
  .on-github {
    margin-top: var(--space-6);
  }
  .on-github :global(.summary) {
    font-size: var(--size-body);
  }
</style>

<style is:global>
  /* The pipeline is drawn by an island, so its look is global, kept under .pipeline. */
  .pipeline .standings {
    margin-top: var(--space-3);
  }
  .pipeline .every-agent {
    margin-top: var(--space-4);
  }
  .pipeline .every-agent > summary {
    display: inline-flex;
    list-style: none;
    cursor: pointer;
  }
  .pipeline .every-agent > summary::-webkit-details-marker {
    display: none;
  }
  .pipeline .every-agent[open] > summary {
    background: var(--ink);
    color: var(--paper);
  }
  /* Positioned, so the hidden "Not run" words inside it are measured against it and not the page. */
  .pipeline .scroll {
    position: relative;
    overflow-x: auto;
    margin-top: var(--space-3);
  }
  .pipeline .scroll:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  .pipeline table {
    width: 100%;
    max-width: none;
    border-collapse: collapse;
  }
  .pipeline th,
  .pipeline td {
    padding: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }
  .pipeline thead th {
    font-weight: 700;
  }
  /* The phase row stands on one strong rule, the corner included, so the head reads as one line. */
  .pipeline thead tr:first-child > * {
    border-bottom: var(--rule-strong) solid var(--ink);
  }
  .pipeline .phase {
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .pipeline .opens {
    border-left: var(--rule-width) solid var(--ink);
  }
  .pipeline tbody th {
    font-weight: 400;
    white-space: normal;
    min-width: 12rem;
  }
  .pipeline .none {
    color: var(--quiet);
  }
  .pipeline .when {
    display: block;
    margin-top: var(--space-1);
  }
</style>

---
// Why: where an origin begins. One big button to talk, and a way to write or paste instead when the thought
// already exists as text; either way it is kept exactly as it came and opened as a pull request.
import Studio from '../../layouts/Studio.astro';
import { Recorder } from '../../islands/Recorder';
---

<Studio description="Say a new thought, or paste it.">
  <h1>Talk</h1>
  <p class="quiet">Talk. Don't tidy. It is kept exactly as it comes out.</p>

  <Recorder client:load mode="origin" />

  <p class="small quiet">
    What you say becomes the origin: every tidied version points back to it, word for word.
  </p>
</Studio>

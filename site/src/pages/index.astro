---
// Why: the front page is the messages, nothing else. A reader sees the point of every post in three lines
// and picks one. The graph will take over this page in phase 3; until then the list is the map.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { settings } from '../lib/settings';
import ThoughtList from '../components/ThoughtList.astro';
import ThemeNav from '../components/ThemeNav.astro';

const thoughts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Page
  title={settings.site.name}
  description={`${settings.site.tagline}. Thoughts by ${settings.site.author}, each one starting as a voice note.`}
>
  <h1 class="visually-hidden">{settings.site.name}</h1>
  <p class="lead">
    Every post here starts as a voice note, kept exactly as it was spoken. What you read is a
    conversion of it, and the origin is always one click away.
  </p>

  {
    thoughts.length === 0 && (
      <p class="quiet">Nothing published yet. The first thought is on its way.</p>
    )
  }

  <ThemeNav thoughts={thoughts} />
  <ThoughtList thoughts={thoughts} />
</Page>

<style>
  .lead {
    color: var(--quiet);
    margin-bottom: var(--space-4);
  }
</style>

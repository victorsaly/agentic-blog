---
// Why: the front page is the newest ten thoughts, each a print, a title and its message, so a reader sees
// the point of every post and picks one. Older ones are one link away. The graph takes over in phase 3.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { settings } from '../lib/settings';
import ThoughtList from '../components/ThoughtList.astro';
import ThemeNav from '../components/ThemeNav.astro';

const all = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const NEWEST = 10;
const thoughts = all.slice(0, NEWEST);
---

<Page
  title={settings.site.name}
  description={`${settings.site.tagline}. Thoughts by ${settings.site.author}, each one starting as an unedited note, the origin.`}
>
  <h1 class="visually-hidden">{settings.site.name}</h1>
  <p class="lead">
    Every post here starts as a note, spoken or written, kept exactly as it came out: the origin.
    What you read is a conversion of it, and the origin is always one click away.
  </p>

  {
    thoughts.length === 0 && (
      <p class="quiet">Nothing published yet. The first thought is on its way.</p>
    )
  }

  <ThemeNav thoughts={all} />
  <ThoughtList thoughts={thoughts} />
  {
    all.length > NEWEST && (
      <p class="more">
        <a href="/all">All {all.length} thoughts</a>
      </p>
    )
  }
</Page>

<style>
  .lead {
    color: var(--quiet);
    margin-bottom: var(--space-4);
  }
  .more {
    margin-top: var(--space-4);
  }
</style>

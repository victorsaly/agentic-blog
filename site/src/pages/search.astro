---
// Why: search over every published post and original, built into a static index at build time by
// Pagefind, so it needs no server and sends nothing anywhere. It indexes the post text and the originals
// (data-pagefind-body, tagged kind:post or kind:origin), never the studio. The header's Search opens the
// same index in a docked panel; this page is where Search leads without a script.
import Page from '../layouts/Page.astro';
---

<Page title="Search" description="Search every thought.">
  <h1>Search</h1>
  <div id="search"></div>
  <p id="search-missing" class="quiet" hidden>
    Search works on the built site. In local development, run <code>npm run build</code> and open the
    built copy.
  </p>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline>
    (() => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        // eslint-disable-next-line no-undef
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: 'Search the thoughts' },
        });
      };
      script.onerror = () => {
        document.getElementById('search-missing').hidden = false;
      };
      document.head.append(script);
    })();
  </script>
</Page>

<style is:global>
  /* Pagefind's own UI, brought into the site: one font, the tokens, no rounded corners. */
  #search {
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--ink);
    --pagefind-ui-tag: var(--paper);
    --pagefind-ui-border-width: var(--rule-width);
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: inherit;
    --pagefind-ui-scale: 1;
  }
  /* A match is marked in marigold, as in the docked search panel. */
  #search mark {
    background: var(--mark);
    color: var(--mark-ink);
  }
</style>

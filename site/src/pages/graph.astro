---
// Why: the first post promised a blog you can walk, not a feed: me in the middle, the topics around me, the
// small ideas on the outside, one idea able to sit under two topics, nothing placed by hand. This page
// draws that from the Small ideas table of every post, so the shape says what the blog is about before a
// word is read. One plain line above it says what to do with it. The picture leads; beside it (under it on a phone) the same graph is a list, which is what
// the keyboard and a screen reader use. Opening a topic, from either side, darkens its ideas and marks its
// name in marigold, the one colour, with no script and no motion. Each idea in the list links to the
// section of its post that says it, or to the start of the whole piece when no section is clearly the one.
// A little script adds what CSS cannot: type a word and only the ideas that say it stay (the matching words
// marked, as search marks them); click a dot to keep its words in the middle with a way to read it and a way
// to ask the chat about it; and every idea in the list can be asked about with one press.
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import ListHead from '../components/ListHead.astro';
import GraphPicture from '../components/GraphPicture.astro';
import { leafOf, thoughtSlugOf } from '../lib/content';
import { graphOf, type GraphPost } from '../lib/graph';
import { deskLayout, layoutGraph, phoneLayout } from '../lib/graph-layout';
import { sectionFor, sectionsOf } from '../lib/idea-sections';
import { settings } from '../lib/settings';
import { thoughtsLabel } from '../lib/themes';
import { topicName } from '../lib/topic-name';

// Typed at the boundary: on a fresh checkout Astro has not generated its content types yet when lint runs.
interface ThoughtEntry {
  id: string;
  body?: string;
  data: { title: string; draft: boolean; themes: string[] };
}
interface VersionEntry {
  id: string;
  body?: string;
}
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
// Typed here for the same reason: without generated types, render() is untyped when lint runs.
const renderEntry = render as unknown as (entry: VersionEntry) => Promise<{ headings: Heading[] }>;

const entries = (await getCollection('thoughts')) as unknown as ThoughtEntry[];
const posts: GraphPost[] = entries.map((e) => ({
  slug: thoughtSlugOf(e.id),
  title: e.data.title,
  draft: e.data.draft,
  body: e.body ?? '',
}));
const graph = graphOf(posts, settings.themes);
const desk = layoutGraph(graph, deskLayout, settings.topic_names);
const phone = layoutGraph(graph, phoneLayout, settings.topic_names);
// Each face says what it shows: dots while they fit, the topics alone once they would touch.
const captionOf = (crowded: boolean): string =>
  crowded
    ? 'The more small ideas a topic holds, the longer its arc. They are too many to draw one by one here; the list holds every one.'
    : 'The more small ideas a topic holds, the longer its arc. A dot in the gap between two arcs belongs to both.';

// A topic has its own page only when a whole post carries it (see topics/[topic].astro).
const topicPages = new Set(entries.filter((e) => !e.data.draft).flatMap((e) => e.data.themes));

// Where each idea's link lands: its section of the long version, with the address the post page gives that
// heading; the whole piece (#road) when no section is clearly the one; the post itself when it has no road.
const longs = ((await getCollection('versions')) as unknown as VersionEntry[]).filter(
  (v) => leafOf(v.id) === 'long',
);
const sectionsBySlug = new Map(
  await Promise.all(
    longs.map(async (v) => {
      const headings = (await renderEntry(v)).headings.filter((h) => h.depth === 2);
      return [thoughtSlugOf(v.id), sectionsOf(v.body ?? '', headings)] as const;
    }),
  ),
);
const hrefs = new Map(
  graph.ideas.map((i) => {
    const sections = sectionsBySlug.get(i.slug);
    const base = `/thoughts/${i.slug}`;
    if (sections === undefined) return [i.id, base];
    const found = sectionFor(i.text, sections);
    return [i.id, found ? `${base}#${found.slug}` : `${base}#road`];
  }),
);

const ideasLabel = (n: number): string => (n === 1 ? 'One small idea' : `${String(n)} small ideas`);
// A topic shows its first ideas; the rest wait behind one control, so a long topic is not a wall of links.
const shown = 3;
const postCount = new Set(graph.ideas.map((i) => i.slug)).size;
// The note says how to read the picture, and its shape in words, for a reader who cannot see it.
const biggest = graph.topics[0];
const sharedCount = graph.ideas.filter((i) => i.topics.length > 1).length;
const note =
  graph.ideas.length === 0
    ? 'Nothing to draw yet: the graph grows from the small ideas in each thought.'
    : [
        `Each arc is a topic, each dot one small idea: ${ideasLabel(graph.ideas.length).toLowerCase()} from ${thoughtsLabel(postCount).toLowerCase()}.`,
        biggest ? `${topicName(biggest.topic)} holds the most.` : '',
        sharedCount > 0
          ? `${sharedCount === 1 ? 'One sits' : `${String(sharedCount)} sit`} under two topics at once.`
          : '',
      ]
        .filter((line) => line !== '')
        .join(' ');

// One topic at a time is opened: by its address (#t-topic), by pointing at it, or by tabbing through its
// part of the list. Everything else steps back. Written out per topic, since CSS cannot compare attributes.
const safe = graph.topics.map((t) => t.topic).filter((t) => /^[a-z0-9-]+$/.test(t));
// Only one topic is open at a time, so the states have an order: pointing at a topic beats tabbing through
// one, and both beat the topic named in the address. On a touch screen a tap can leave :hover behind, so
// there the pointer plays no part.
const hovering = '[data-topic]:hover, .list > section:hover';
const tabbing = '.list > section:focus-within';
const openBy = (t: string, pointer: boolean): string[] => [
  ...(pointer ? [`.walk:has([data-topic="${t}"]:hover)`, `.walk:has(#t-${t}:hover)`] : []),
  `.walk:has(#t-${t}:focus-within)${pointer ? `:not(:has(${hovering}))` : ''}`,
  `.walk:has(#t-${t}:target):not(:has(${pointer ? `${hovering}, ` : ''}${tabbing}))`,
];
const rules = (pointer: boolean): string =>
  safe
    .map((t) => {
      const on = openBy(t, pointer);
      const dim = on.map((s) => `${s} .graph-picture [data-t]:not([data-t~="${t}"])`).join(',');
      const arc = on.map((s) => `${s} .graph-picture [data-topic="${t}"] .arc`).join(',');
      const name = on.map((s) => `${s} .graph-picture [data-topic="${t}"] .name`).join(',');
      return `${dim}{opacity:.16}${arc}{stroke-width:var(--rule-heavy)}${name}{stroke:var(--mark);fill:var(--mark-ink)}`;
    })
    .join('');
// Pointing at a dot sets its words in the middle and steps back every idea from another post, so the
// ideas a post holds show together.
const slugs = [...new Set(graph.ideas.map((i) => i.slug))].filter((p) => /^[a-z0-9-]+$/.test(p));
const pointing =
  graph.ideas
    .filter((i) => /^[a-z0-9:-]+$/.test(i.id))
    .map(
      (i) =>
        `.graph-picture:has([data-idea="${i.id}"]:hover) [data-for="${i.id}"]{visibility:visible}`,
    )
    .join('') +
  // Pointing fades the other posts only while nothing is kept; a kept idea's post holds until it is let go.
  slugs
    .map(
      (p) =>
        `.graph-picture:not(.pinned):has([data-idea][data-p="${p}"]:hover) [data-p]:not([data-p="${p}"]){opacity:.16}`,
    )
    .join('');
// Tabbing to an idea in the list sets its words in the middle of the picture, as pointing at its dot does.
// Only one idea's words can show, so the same order as for topics holds: pointing at a dot wins over the
// keyboard, and the idea in focus steps back while a pointer rests on a dot.
const pointingAtDot = ':not(:has(.graph-picture [data-idea]:hover))';
const focusing =
  graph.ideas
    .filter((i) => /^[a-z0-9:-]+$/.test(i.id))
    .map(
      (i) =>
        `.walk:has([data-item="${i.id}"] a:focus-visible)${pointingAtDot} .graph-picture [data-for="${i.id}"]{visibility:visible}`,
    )
    .join('') + '.walk:has(.ideas a:focus-visible) .has-tips .core{visibility:hidden}';
// An idea kept by a click dims every other post's ideas, as pointing at it does.
const pinnedRules = slugs
  .map(
    (p) =>
      `.graph-picture.pinned[data-pinned-post="${p}"] [data-p]:not([data-p="${p}"]){opacity:.16}`,
  )
  .join('');
const css = `${focusing}${pinnedRules}@media (hover:none),(pointer:coarse){${rules(false)}}@media (hover:hover) and (pointer:fine){${rules(true)}${pointing}}`;
---

<Page
  title="Graph"
  description="Every topic the thoughts cover and every small idea in them, drawn as one graph."
  width="wide"
>
  <ListHead label="Graph" title="How the thoughts connect" note={note} compact />
  <Fragment set:html={`<style>${css}</style>`} />
  {
    graph.ideas.length > 0 && (
      <div class="frame walk">
        <div class="picture">
          <p class="how">
            <span class="pointer">Point at a dot to read it, click to keep it.</span>
            <span class="touch">Tap a topic to see its ideas.</span>
          </p>
          <figure
            id="graph"
            tabindex="-1"
            aria-label={`A graph of ${String(graph.topics.length)} topics and ${ideasLabel(graph.ideas.length).toLowerCase()}; the same is listed beside it.`}
          >
            <div class="stage">
              <GraphPicture
                layout={desk}
                id="graph-desk"
                class="desk"
                hrefs={hrefs}
                name={settings.site.author}
              />
              <div class="pin" hidden data-pin role="region" aria-label="The idea you kept">
                <p class="pin-text" data-pin-text />
                <p class="small quiet" data-pin-from />
                <p class="pin-actions">
                  <a class="control" href="#graph" data-pin-read>
                    Read where it's said
                  </a>
                  <button type="button" class="control" data-ask-idea="">
                    Ask about this
                  </button>
                  <button type="button" class="control" data-pin-close>
                    Close
                  </button>
                </p>
              </div>
            </div>
            <GraphPicture
              layout={phone}
              id="graph-phone"
              class="phone"
              hrefs={hrefs}
              name={settings.site.author}
            />
            <figcaption class="small quiet">
              {desk.crowded === phone.crowded ? (
                captionOf(desk.crowded)
              ) : (
                <>
                  <span class="for-desk">{captionOf(desk.crowded)}</span>
                  <span class="for-phone">{captionOf(phone.crowded)}</span>
                </>
              )}
            </figcaption>
          </figure>
        </div>

        <div class="list">
          <form class="find" role="search" hidden>
            <label for="find-idea">Find an idea</label>
            <span class="find-row">
              <input
                id="find-idea"
                type="search"
                autocomplete="off"
                placeholder="a word, like note"
              />
              <button type="button" class="control" data-find-clear hidden>
                Clear
              </button>
            </span>
            <p class="small quiet found" aria-live="polite" data-found />
          </form>
          <p class="none" hidden data-none />
          {graph.topics.map((t) => {
            const ideas = graph.ideas.filter((i) => i.topics.includes(t.topic));
            const item = (i: (typeof ideas)[number]) => {
              const others = i.topics.filter((o) => o !== t.topic);
              return (
                <li data-item={i.id} data-thought={i.title}>
                  <a href={hrefs.get(i.id) ?? `/thoughts/${i.slug}`}>{i.text}</a>
                  <p class="small quiet from">
                    From the thought “{i.title}”.
                    {others.length > 0 &&
                      ` Also under ${others.map((o) => topicName(o)).join(' and ')}.`}
                  </p>
                  <p class="actions">
                    <button type="button" class="ask-idea" data-ask-idea={i.id} hidden>
                      Ask about this
                    </button>
                  </p>
                </li>
              );
            };
            return (
              <section id={`t-${t.topic}`} aria-labelledby={`t-${t.topic}-name`}>
                <h2 id={`t-${t.topic}-name`}>
                  <a href={`#t-${t.topic}`}>
                    <span class="name">{topicName(t.topic)}</span>
                  </a>
                </h2>
                <p class="small quiet count">
                  <span data-count data-all={ideasLabel(t.ideas)}>
                    {ideasLabel(t.ideas)}
                  </span>
                  {!topicPages.has(t.topic) && ', so far only inside thoughts about other topics'}.
                </p>
                {topicPages.has(t.topic) && (
                  <p class="every">
                    <a href={`/topics/${t.topic}`}>Every thought on {topicName(t.topic)}</a>
                  </p>
                )}
                <ol class="ideas">{ideas.slice(0, shown).map(item)}</ol>
                {ideas.length > shown && (
                  <details>
                    <summary>
                      <span class="more">Show all {ideas.length} ideas</span>
                      <span class="less">Show fewer</span>
                    </summary>
                    <ol class="ideas" start={shown + 1}>
                      {ideas.slice(shown).map(item)}
                    </ol>
                  </details>
                )}
                <p class="back">
                  <a href="#graph">Back to the graph</a>
                </p>
              </section>
            );
          })}
        </div>
      </div>
    )
  }
</Page>

<style>
  .walk {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }
  /* The picture chooses its drawing by its own width, not the window's: when the chat docks beside the page
     and the column narrows, it turns to the phone drawing, whose names stay large, instead of shrinking. */
  .picture {
    margin: 0;
    container-type: inline-size;
  }
  .picture :global(.desk),
  .for-desk {
    display: none;
  }
  /* On a phone the picture takes the whole width of the screen, so its names can be read; its own margin
     keeps them off the edge. */
  @media (max-width: 40rem) {
    .picture :global(.phone) {
      width: calc(100% + 2 * var(--pad));
      max-width: none;
      margin-inline: calc(-1 * var(--pad));
    }
  }
  figure {
    margin: 0;
    scroll-margin-top: 6rem;
  }
  .how {
    margin: 0 0 var(--space-3);
    max-width: 50ch;
  }
  .how .touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .how .pointer {
      display: none;
    }
    .how .touch {
      display: inline;
    }
  }
  figcaption {
    margin-top: var(--space-3);
    max-width: 50ch;
  }
  .find {
    display: grid;
    gap: var(--space-2);
    max-width: 28rem;
    margin: 0 0 var(--space-4);
  }
  .find label {
    font-weight: 700;
  }
  .find-row {
    display: flex;
    gap: var(--space-2);
  }
  .find input {
    flex: 1;
    min-width: 0;
    font: inherit;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: var(--rule-width) solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  /* The quiet ink, which holds 7:1 in light and dark; the browser's grey falls under 4.5 on charcoal. */
  .find input::placeholder {
    color: var(--quiet);
    opacity: 1;
  }
  /* The house Clear control replaces the browser's own blue cross. */
  .find input::-webkit-search-cancel-button {
    display: none;
  }
  .none {
    margin: 0 0 var(--space-4);
    font-size: var(--size-body);
    font-weight: 700;
  }
  .found {
    margin: 0;
    min-height: 1.5em;
  }
  /* While a word is typed, only the ideas that say it stay; in the picture the rest fade, in the list they
     go, and a topic with none goes with them. The matching words carry the one colour, as search marks them. */
  .walk[data-filtering] .list li[data-item]:not([data-match]),
  .walk[data-filtering] .list section[data-empty],
  .walk[data-filtering] .list summary {
    display: none;
  }
  .walk[data-filtering] :global(.graph-picture [data-idea]:not([data-match])),
  .walk[data-filtering] :global(.graph-picture .edges [data-i]:not([data-match])) {
    opacity: 0.16;
  }
  /* The marks are made by the script, so the rule must reach elements Astro never scoped. */
  .ideas :global(mark) {
    background: var(--mark);
    color: var(--mark-ink);
  }
  /* In the picture a matching dot carries the one colour too, so a match can be found among the faded. */
  .walk[data-filtering] :global(.graph-picture [data-idea][data-match] circle:not(.hit)) {
    fill: var(--mark);
    stroke: var(--ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  /* The words of a kept idea, set over the middle of the ring with the two things a reader can do next. */
  .stage {
    position: relative;
  }
  .pin {
    position: absolute;
    transform: translate(-50%, -50%);
    text-align: center;
    background: var(--paper);
    padding: var(--space-2);
  }
  .pin-text {
    margin: 0;
    font-weight: 700;
    font-size: var(--size-body);
    line-height: var(--leading-tight);
  }
  .pin p {
    max-width: none;
  }
  .pin-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }
  .actions {
    margin: 0;
  }
  .ask-idea {
    font: inherit;
    font-size: var(--size-small);
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .ask-idea:hover,
  .ask-idea:focus-visible {
    text-decoration-thickness: 0.1em;
  }
  section {
    padding-top: var(--space-3);
    border-top: var(--rule-strong) solid var(--ink);
  }
  section + section {
    margin-top: var(--space-5);
  }
  h2 {
    margin: 0;
    font-size: var(--size-h2);
    line-height: var(--leading-tight);
  }
  h2 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }
  h2 a:hover .name,
  h2 a:focus-visible .name {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
  }
  section:target .name {
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0.05em 0.2em;
  }
  .count {
    margin: 0;
  }
  .every {
    margin: 0 0 var(--space-2);
  }
  .every a,
  .back a,
  summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .ideas {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .ideas li {
    padding-block: var(--space-3);
    border-top: var(--rule-width) solid var(--rule);
  }
  /* Two or three lines of link a row: open spacing and a thin line under the words, so a block of links
     does not read as stripes; the line thickens under the one being pointed at. */
  .ideas a {
    font-size: var(--size-body);
    line-height: var(--leading);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .ideas a:hover,
  .ideas a:focus-visible {
    text-decoration-thickness: 0.1em;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    border-top: var(--rule-width) solid var(--rule);
    width: 100%;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .more,
  details:not([open]) .less {
    display: none;
  }
  .back {
    margin: var(--space-2) 0 0;
  }
  .ideas p {
    margin: var(--space-1) 0 0;
  }

  @container (min-width: 35rem) {
    .picture :global(.desk),
    .for-desk {
      display: block;
    }
    .picture :global(.phone),
    .for-phone {
      display: none;
    }
  }

  /* On a desk the picture stays in view while the list scrolls beside it. */
  @media (min-width: 64rem) {
    .walk {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
      gap: var(--space-6);
    }
    .picture {
      position: sticky;
      top: 6rem;
    }
    .picture :global(.desk) {
      max-height: calc(100svh - 14rem);
    }
    /* The picture stays beside the list on a desk, so there is nothing to go back to. */
    .back {
      display: none;
    }
  }
</style>

<script>
  // Why: three things CSS cannot do on the graph. Find: a typed word keeps only the ideas that say it, in
  // the picture and the list. Keep: a click on a dot holds that idea's words over the middle, with a way to
  // read it and a way to ask about it. Ask: any idea in the list can be put to the chat with one press. Each
  // works from what the page already holds; nothing is fetched, and nothing moves.
  import { matchingIdeas, segmentsOf, termsOf } from '../lib/graph-filter';

  const walk = document.querySelector<HTMLElement>('.walk');
  const form = document.querySelector<HTMLFormElement>('.find');
  const input = document.querySelector<HTMLInputElement>('#find-idea');
  const found = document.querySelector<HTMLElement>('[data-found]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  const clear = document.querySelector<HTMLButtonElement>('[data-find-clear]');
  // Without the script the find box would do nothing, so it shows only now.
  if (form) form.hidden = false;
  const rows = [...document.querySelectorAll<HTMLLIElement>('.list [data-item]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.list > section')];
  const pictures = [...document.querySelectorAll<SVGSVGElement>('.graph-picture')];

  // Every idea once, with its words and the thought it comes from (a shared idea has a row per topic).
  const texts = new Map<string, string>();
  const thoughts = new Map<string, string>();
  for (const li of rows) {
    const id = li.dataset.item ?? '';
    if (id === '' || texts.has(id)) continue;
    texts.set(id, li.querySelector('a')?.textContent?.trim() ?? '');
    thoughts.set(id, li.dataset.thought ?? '');
  }
  // The topics' reader names, as the list's headings give them.
  const topicNames = new Map(
    sections.map((s) => [
      s.id.replace(/^t-/, ''),
      s.querySelector('.name')?.textContent?.trim() ?? '',
    ]),
  );
  const all = [...texts].map(([id, text]) => ({ id, text }));

  // Find.
  const markRow = (a: HTMLAnchorElement, terms: string[]): void => {
    const text = a.dataset.text ?? a.textContent ?? '';
    a.dataset.text = text;
    a.replaceChildren(
      ...segmentsOf(text, terms).map((s) =>
        s.hit
          ? Object.assign(document.createElement('mark'), { textContent: s.text })
          : document.createTextNode(s.text),
      ),
    );
  };
  function applyFilter(query: string): void {
    const terms = termsOf(query);
    const hits = matchingIdeas(terms, all);
    const on = terms.length > 0;
    walk?.toggleAttribute('data-filtering', on);
    for (const li of rows) {
      li.toggleAttribute('data-match', hits.has(li.dataset.item ?? ''));
      const a = li.querySelector('a');
      if (a) markRow(a, terms);
    }
    for (const picture of pictures) {
      for (const el of picture.querySelectorAll<SVGElement>('[data-idea]'))
        el.toggleAttribute('data-match', hits.has(el.dataset.idea ?? ''));
      for (const el of picture.querySelectorAll<SVGElement>('.edges [data-i]'))
        el.toggleAttribute('data-match', hits.has(el.dataset.i ?? ''));
    }
    for (const section of sections) {
      const own = [...section.querySelectorAll<HTMLLIElement>('[data-item]')];
      const n = own.filter((li) => hits.has(li.dataset.item ?? '')).length;
      section.toggleAttribute('data-empty', on && n === 0);
      // A folded topic opens while a word is typed, so its matches show, and folds back after.
      const details = section.querySelector('details');
      if (details) {
        if (on) {
          details.dataset.was ??= details.open ? 'open' : 'shut';
          details.open = true;
        } else if (details.dataset.was !== undefined) {
          details.open = details.dataset.was === 'open';
          delete details.dataset.was;
        }
      }
      const count = section.querySelector<HTMLElement>('[data-count]');
      if (count)
        count.textContent = on
          ? `${String(n)} of ${String(own.length)} match`
          : (count.dataset.all ?? '');
    }
    if (found)
      found.textContent = !on
        ? ''
        : hits.size === 0
          ? `No small idea says “${query.trim()}”.`
          : `${String(hits.size)} of ${String(all.length)} small ideas.`;
    // With nothing found the list column would be empty; say so there, at full size, with a way out.
    if (none) {
      none.hidden = !(on && hits.size === 0);
      none.textContent = `No small idea says “${query.trim()}”. Try a shorter word, or clear the box.`;
    }
    if (clear) clear.hidden = !on;
  }
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
  });
  input?.addEventListener('input', () => {
    applyFilter(input.value);
  });
  clear?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    applyFilter('');
    input.focus();
  });
  if (input && input.value !== '') applyFilter(input.value);

  // Keep.
  const figure = document.querySelector<HTMLElement>('#graph');
  const stage = document.querySelector<HTMLElement>('.stage');
  const panel = document.querySelector<HTMLElement>('[data-pin]');
  const pinText = panel?.querySelector<HTMLElement>('[data-pin-text]');
  const pinFrom = panel?.querySelector<HTMLElement>('[data-pin-from]');
  const pinRead = panel?.querySelector<HTMLAnchorElement>('[data-pin-read]');
  const pinAsk = panel?.querySelector<HTMLButtonElement>('[data-ask-idea]');
  const pinClose = panel?.querySelector<HTMLButtonElement>('[data-pin-close]');
  let kept: SVGAElement | null = null;
  // Where the reader was before keeping an idea, so letting go returns them there.
  let before: HTMLElement | null = null;

  // The panel sits over the middle of the ring, however the picture is sized: the picture's own (0, 0).
  function place(): void {
    const svg = stage?.querySelector<SVGSVGElement>('.graph-picture');
    const matrix = svg?.getScreenCTM();
    if (!svg || !panel || !stage || !matrix) return;
    const centre = new DOMPoint(0, 0).matrixTransform(matrix);
    const box = stage.getBoundingClientRect();
    panel.style.left = `${String(centre.x - box.left)}px`;
    panel.style.top = `${String(centre.y - box.top)}px`;
    panel.style.width = `${String(Math.round(Number(svg.dataset.inner ?? 0) * matrix.a))}px`;
  }
  function unpin(): void {
    const was = kept;
    kept?.removeAttribute('data-pinned');
    kept = null;
    // Focus inside the panel goes back to the same idea in the list (a shared idea is listed under each of
    // its topics, and some sit in a closed "Show all"), not to the dot, which is hidden from assistive tech;
    // else to where the reader was, if that was more than the page itself; else to the picture.
    if (was && panel?.contains(document.activeElement)) {
      const rows = document.querySelectorAll<HTMLAnchorElement>(
        `.list [data-item="${CSS.escape(was.dataset.idea ?? '')}"] a`,
      );
      const row = [...rows].find((a) => a.checkVisibility());
      const back = before && before !== document.body && before.isConnected ? before : null;
      (row ?? back ?? figure)?.focus({ preventScroll: true });
    }
    for (const picture of pictures) {
      picture.classList.remove('pinned');
      picture.removeAttribute('data-pinned-post');
    }
    if (panel) panel.hidden = true;
  }
  function pin(dot: SVGAElement): void {
    if (kept === dot) {
      unpin();
      return;
    }
    unpin();
    before = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const id = dot.dataset.idea ?? '';
    kept = dot;
    dot.setAttribute('data-pinned', '');
    const picture = dot.closest<SVGSVGElement>('.graph-picture');
    picture?.classList.add('pinned');
    picture?.setAttribute('data-pinned-post', dot.dataset.p ?? '');
    if (pinText) pinText.textContent = texts.get(id) ?? '';
    // Said from the dot's own data, so a shared idea names both its topics.
    const under = (dot.dataset.t ?? '').split(' ').map((t) => topicNames.get(t) ?? t);
    if (pinFrom)
      pinFrom.textContent = `From the thought “${thoughts.get(id) ?? ''}”. Under ${under.join(' and ')}.`;
    if (pinRead) pinRead.href = dot.getAttribute('href') ?? '#graph';
    if (pinAsk) pinAsk.dataset.askIdea = id;
    if (panel) panel.hidden = false;
    place();
    pinRead?.focus({ preventScroll: true });
  }
  for (const dot of document.querySelectorAll<SVGAElement>('.graph-picture a[data-idea]')) {
    dot.addEventListener('click', (event) => {
      // A click with a modifier, or not the main button, does what a link does: a new tab, a new window.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)
        return;
      event.preventDefault();
      pin(dot);
    });
  }
  pinClose?.addEventListener('click', unpin);
  // One Escape closes one thing: the chat, when it is open, takes it first.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !kept || event.defaultPrevented) return;
    if (document.documentElement.hasAttribute('data-dock')) return;
    unpin();
  });
  // The picture changes size with the window, and when the chat docks beside the page; the panel follows.
  if (stage)
    new ResizeObserver(() => {
      if (!kept) return;
      // The column narrowed to the phone drawing: the kept dot is no longer drawn, so let it go.
      if (kept.closest('svg')?.checkVisibility() !== true) unpin();
      else place();
    }).observe(stage);

  // Ask. The chat lives in the header; the buttons show only when it is there and the script runs. Each
  // says which idea it asks about, so a screen reader does not hear thirty-six identical buttons.
  const chat = document.querySelector('.ask-open') !== null;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-ask-idea]')) {
    // No chat (a private build): no button asks it, the kept panel's included.
    if (!chat) {
      button.hidden = true;
      continue;
    }
    const named = (): void => {
      const text = texts.get(button.dataset.askIdea ?? '') ?? '';
      if (text) button.setAttribute('aria-label', `Ask about this: ${text}`);
    };
    named();
    button.hidden = false;
    button.addEventListener('click', () => {
      const text = texts.get(button.dataset.askIdea ?? '') ?? '';
      if (text === '') return;
      // The chat docks beside the page and the picture narrows; a kept idea lets go rather than be squeezed.
      unpin();
      dispatchEvent(
        new CustomEvent('ask:open', { detail: { question: `Tell me more about this: “${text}”` } }),
      );
    });
    // The kept panel's button changes idea each time; only that change renames it (watching every attribute
    // would loop, since naming it is itself one).
    if (button.closest('[data-pin]'))
      new MutationObserver(named).observe(button, { attributeFilter: ['data-ask-idea'] });
  }

  // "Back to the graph" keeps the topic the reader opened lit: it scrolls to the picture without
  // changing the address, so #t-topic still names the topic, and takes the keyboard there too, so the next
  // Tab starts from the picture and not from the bottom of the topic just left.
  for (const back of document.querySelectorAll<HTMLAnchorElement>('.back a')) {
    back.addEventListener('click', (event) => {
      if (!figure) return;
      event.preventDefault();
      figure.scrollIntoView({ block: 'start' });
      figure.focus({ preventScroll: true });
    });
  }
</script>

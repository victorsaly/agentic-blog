---
// Why: one post, three depths. The message is the only loud thing; the idea is open; the road and the origin
// are a click away. Every converted version on the page carries the badge that points at the origin.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Page from '../../layouts/Page.astro';
import Badge from '../../components/Badge.astro';
import Depth from '../../components/Depth.astro';
import { settings } from '../../lib/settings';
import {
  excerpt,
  formatDate,
  leafOf,
  readingLabel,
  readingMinutes,
  thoughtSlugOf,
} from '../../lib/content';
import { coverOf, picturesFrom } from '../../lib/pictures';
import { themeLabel } from '../../lib/themes';

// Every drawing in the repo, so the cover can be looked up by its path in the thought folder.
const drawings = import.meta.glob<ImageMetadata>('../../../../thoughts/*/image/*.png', {
  eager: true,
  import: 'default',
});

export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts', ({ data }) => !data.draft);
  return thoughts.map((thought) => ({
    params: { slug: thoughtSlugOf(thought.id) },
    props: { thought },
  }));
}

const { thought } = Astro.props;
const slug = thoughtSlugOf(thought.id);

const versions = await getCollection('versions', ({ id }) => thoughtSlugOf(id) === slug);
const origins = await getCollection('origins', ({ id }) => thoughtSlugOf(id) === slug);

const short = versions.find((v) => leafOf(v.id) === 'short');
const long = versions.find((v) => leafOf(v.id) === 'long');
const firstOrigin = origins[0];

const pictureList = (await getCollection('pictures', ({ id }) => thoughtSlugOf(id) === slug))[0];
const cover = coverOf(picturesFrom(pictureList?.data));
const coverImage = cover
  ? Object.entries(drawings).find(([path]) => path.endsWith(`/thoughts/${slug}/${cover.file}`))?.[1]
  : undefined;

// Sources reach readers only after Victor has opened every link. In local development they show
// unreviewed, marked as such, so the review can happen on the page itself.
const sourcesEntry = (await getCollection('sources', ({ id }) => thoughtSlugOf(id) === slug))[0];
const showSources = sourcesEntry && (sourcesEntry.data.reviewed || import.meta.env.DEV);
const sources = showSources ? await render(sourcesEntry) : null;

const { Content: Structure } = await render(thought);
const idea = short ? await render(short) : null;
const road = long ? await render(long) : null;

const originHref = `/thoughts/${slug}/origin`;
const minutes = readingMinutes(long?.body ?? short?.body ?? thought.body ?? '');
const description = excerpt(thought.data.message, 40);
---

<Page
  title={thought.data.title}
  description={description}
  lang={thought.data.language}
  type="article"
  publishedAt={thought.data.date}
>
  <article data-pagefind-body>
    <Badge originHref={originHref} by={long?.data.converted_by ?? short?.data.converted_by} />
    <h1>{thought.data.title}</h1>
    <p class="small quiet meta" data-pagefind-ignore>
      <time datetime={thought.data.date.toISOString()}>{formatDate(thought.data.date)}</time>
      <span>{readingLabel(minutes)} to walk the whole road</span>
    </p>

    <p class="message"><mark>{thought.data.message}</mark></p>

    {
      cover && coverImage && (
        <figure class="cover">
          <Image
            class="drawing"
            src={coverImage}
            alt={cover.alt}
            width={720}
            height={720}
            loading="eager"
          />
          {cover.note && <figcaption class="small quiet">{cover.note}</figcaption>}
        </figure>
      )
    }

    <Depth name="The idea" hint="one screen" open={true} id="idea">
      {idea ? <idea.Content /> : <Structure />}
    </Depth>

    {
      road && (
        <Depth name="The road" hint="the whole piece" id="road">
          {road.headings.filter((h) => h.depth === 2 && !/^what changed/i.test(h.text)).length >
            1 && (
            <nav class="contents small" aria-label="In this road" data-pagefind-ignore>
              <p class="quiet">In this road</p>
              <ol>
                {road.headings
                  .filter((h) => h.depth === 2)
                  .map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
              </ol>
            </nav>
          )}
          <road.Content />
          {!long?.data.reviewed && (
            <p class="small quiet">
              This version has not yet been reviewed by {settings.site.author}. It can still change.
            </p>
          )}
        </Depth>
      )
    }

    {
      sources && sourcesEntry && (
        <Depth name="Sources" hint="where each claim leads" id="sources">
          {!sourcesEntry.data.reviewed && (
            <p class="small quiet">
              Not reviewed yet. Only visible in local development until {settings.site.author} has
              opened every link and set reviewed to true.
            </p>
          )}
          <div class="sources">
            <sources.Content />
          </div>
        </Depth>
      )
    }

    <Depth name="Where it came from" hint="the origin, unedited" id="origin">
      {
        firstOrigin ? (
          <>
            <p>
              {firstOrigin.data.medium === 'text'
                ? `Written ${formatDate(firstOrigin.data.recorded)}, never edited.`
                : `Recorded ${formatDate(firstOrigin.data.recorded)}, ${
                    firstOrigin.data.speakers.length === 1
                      ? 'one voice'
                      : `${String(firstOrigin.data.speakers.length)} voices`
                  }, never edited.`}{' '}
              It starts like this:
            </p>
            <blockquote>{excerpt(firstOrigin.body ?? '', 60)}</blockquote>
            <p>
              <a href={originHref}>Read the whole origin</a>
            </p>
          </>
        ) : (
          <p class="quiet">The origin for this thought is not on the site yet.</p>
        )
      }
    </Depth>

    <nav class="small quiet themes" aria-label="Themes of this thought" data-pagefind-ignore>
      Themes:{' '}
      {
        thought.data.themes.map((theme, i) => (
          <>
            {i > 0 && ', '}
            <a href={`/themes/${theme}`}>{themeLabel(theme)}</a>
          </>
        ))
      }
    </nav>
  </article>
</Page>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: 0;
  }
  .themes {
    margin-top: var(--space-5);
  }
  .contents {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .contents p {
    margin: 0 0 var(--space-1);
  }
  .contents ol {
    margin: 0;
    padding-left: var(--space-4);
  }
  .contents a {
    display: inline-block;
    padding: var(--space-1) 0;
  }
  /* Drawings: black ink on white, inverted with the theme, never wider than the text. */
  .drawing,
  article :global(#road img) {
    display: block;
    width: 100%;
    max-width: var(--measure);
    height: auto;
    filter: var(--drawing-filter);
  }
  .cover {
    margin: var(--space-4) 0;
  }
  .cover figcaption {
    margin-top: var(--space-2);
    max-width: var(--measure);
  }
  /* The line a drawing shows, then the artist's note: quiet, close to the drawing it belongs to. */
  article :global(#road .caption) {
    margin: calc(-1 * var(--space-3)) 0 var(--space-4);
    max-width: 30ch;
    font-size: var(--size-small);
    color: var(--quiet);
  }
  /* Section drawings are square with generous white space; half the measure keeps the road readable. */
  article :global(#road img) {
    max-width: min(100%, 30ch);
    margin: var(--space-3) 0 var(--space-4);
  }
  /* Diagrams the diagram agent described: real text, drawn with rules and spacing only. */
  article :global(.diagram) {
    margin: var(--space-4) 0 var(--space-5);
    max-width: var(--measure);
  }
  article :global(.diagram-title) {
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }
  article :global(.diagram figcaption) {
    margin-top: var(--space-3);
    font-size: var(--size-small);
    color: var(--quiet);
  }
  article :global(.flow) {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  article :global(.flow li) {
    counter-increment: step;
    position: relative;
    border: var(--rule-width) solid var(--ink);
    padding: var(--space-2) var(--space-3);
  }
  article :global(.flow li + li) {
    margin-top: var(--space-4);
  }
  /* The arrow between two steps: a short rule and a tip, in the ink colour. */
  article :global(.flow li + li::before) {
    content: '';
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-4));
    height: var(--space-4);
    border-left: var(--rule-width) solid var(--ink);
  }
  article :global(.flow li + li::after) {
    content: '';
    position: absolute;
    left: calc(var(--space-4) - 0.3rem);
    top: -0.45rem;
    border: 0.3rem solid transparent;
    border-top-color: var(--ink);
    border-bottom: 0;
  }
  article :global(.flow .step) {
    display: block;
    font-weight: 700;
  }
  article :global(.flow .step::before) {
    content: counter(step) '. ';
  }
  article :global(.flow .detail) {
    display: block;
    font-size: var(--size-small);
    color: var(--quiet);
  }
  article :global(.compare) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }
  article :global(.compare .side) {
    border-top: calc(2 * var(--rule-width)) solid var(--ink);
    padding-top: var(--space-2);
  }
  article :global(.compare .side-label) {
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }
  article :global(.compare ul) {
    margin: 0;
    padding-left: var(--space-4);
  }
  /* The sources table scrolls sideways on a phone instead of squeezing the links. */
  .sources {
    overflow-x: auto;
  }
</style>

---
// Why: this page sells the agentic blog to someone who thinks out loud, and then proves it. It opens with
// the promise and a print of the blogger, shows a real note beside the message it became (read from the
// post's own files, so the page cannot tidy the proof), then a real thought going down the route as the
// studio draws it (played from that thought's ledger, so the page cannot tidy the run either), says what
// changes, and plays the road a thought takes. Everything a sceptic or a builder wants to check (the agents,
// the route, the files, the sources) sits folded underneath, one layer down, so the pitch stays short and
// nothing is hidden.
import { join } from 'node:path';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parse } from 'yaml';
import { readRuns } from '@roadbook/core/node';
import Page from '../layouts/Page.astro';
import FlowChart from '../components/FlowChart.astro';
import { RouteReplay } from '../islands/RouteReplay';
import { replayOf } from '../lib/route-replay';
import project from '../../../roadbook.config';
import { Tour } from '../islands/Tour';
import { tour, tourWordsFrom } from '../lib/tour';
import tourWords from '../lib/tour-words.json';
import { firstSentence, phases, rosterFrom, type AgentCardFacts } from '../lib/agents';
import { settings } from '../lib/settings';
// The hero print shows the route, not the blogger; site/src/assets/how-it-works/prompts.md says how it was drawn.
import cover from '../assets/how-it-works/hands-around-one-page.png';
import originRaw from '../../../thoughts/2026-10-23-productive-friction-counts-evidence/origin/text.md?raw';
import structureRaw from '../../../thoughts/2026-10-23-productive-friction-counts-evidence/structure.md?raw';

const repo = 'https://github.com/victorsaly/agentic-blog';
const proofSlug = '2026-10-23-productive-friction-counts-evidence';

// The proof: the first lines of the note exactly as written, and the message and why the post was given.
const body = originRaw.replace(/^---[\s\S]*?\n---\n/, '');
const said = body
  .split('\n')
  .map((l) => l.trim())
  .filter(Boolean)
  .slice(2, 5);
const structure = parse(/^---\r?\n([\s\S]*?)\r?\n---/.exec(structureRaw)?.[1] ?? '') as {
  message?: unknown;
  why?: unknown;
  title?: unknown;
};
const text = (v: unknown): string => (typeof v === 'string' ? v.trim().replace(/\s+/g, ' ') : '');
const message = text(structure.message);
const cuts = text(structure.why);

const agentCards = import.meta.glob<AgentCardFacts>('../../../agents/*/card.ts', {
  import: 'card',
  eager: true,
});
const agentPrompts = import.meta.glob<string>('../../../agents/*/PROMPT.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
// The tour's slides: each station with the real screen of its step, sized here, and the time of every word
// its clip says, so the page underlines the word being said as a post's read-along does.
const screens = import.meta.glob<ImageMetadata>('../assets/tour/*.png', {
  import: 'default',
  eager: true,
});
const timings = tourWordsFrom(tourWords);
const slides = await Promise.all(
  tour.map(async (s) => {
    const shot = screens[`../assets/tour/${s.id}.png`];
    if (!shot) throw new Error(`the tour station ${s.id} has no screen in site/src/assets/tour/`);
    const image = await getImage({ src: shot, widths: [640, 960, 1440], format: 'webp' });
    return {
      ...s,
      words: timings[s.id] ?? [],
      image: {
        src: image.src,
        srcSet: image.srcSet.attribute,
        width: shot.width,
        height: shot.height,
      },
    };
  }),
);

const roster = rosterFrom(Object.values(agentCards), Object.values(agentPrompts));
const byPhase = Object.entries(phases)
  .map(([n, name]) => ({ n: Number(n), name, agents: roster.filter((a) => a.phase === Number(n)) }))
  .filter((p) => p.agents.length > 0);

// A real run: the first thought that went the whole route by itself, played from its ledger on the route the
// studio draws. The route is the workflow in roadbook.config.ts, so the picture changes when the route does.
const runSlug = '2026-10-25-september-last-year-tried';
const runLedger = await readRuns(
  join(process.cwd(), '..', 'thoughts', runSlug),
  `thoughts/${runSlug}`,
);
if (runLedger.issues.length > 0) throw new Error(runLedger.issues.join('\n'));
const blogPost = project.workflows.find((w) => w.id === 'blog-post');
if (!blogPost) throw new Error('roadbook.config.ts has no blog-post workflow');
const person = project.owner.name.split(' ')[0] ?? project.owner.name;
const replay = replayOf(blogPost, runLedger.runs, person);
const inWords = (n: number): string =>
  ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][n] ??
  String(n);
const runMinutes = replay.frames.at(-1)?.minute ?? 0;
const runHours = Math.floor(runMinutes / 60);
const runTook = [
  runHours > 0 ? `${String(runHours)} hour${runHours === 1 ? '' : 's'}` : '',
  `${String(runMinutes % 60)} minutes`,
]
  .filter(Boolean)
  .join(' ');
const agentSteps = replay.layout.steps.filter((s) => s.kind === 'agent' || s.kind === 'guard');
const gateSteps = replay.layout.steps.filter((s) => s.kind === 'gate');

const trail = `flowchart LR
  accTitle: What every post folder holds
  accDescr: The origin feeds the structure; the structure feeds the versions and the image; the versions feed the sources and the road; feedback notes rework the versions; every agent run on the thought is written to its ledger.
  O["origin/<br/>your words, never edited"] --> S["structure.md<br/>the point, cut three ways"]
  S --> V["versions/<br/>short · long · LinkedIn<br/>each with its why"]
  S --> IMG["image/<br/>the print and its prompt"]
  V --> SRC["sources.md<br/>every claim, every link"]
  V --> RD["road.md<br/>who ran, in what order,<br/>told what"]
  FB["feedback/<br/>your notes on the output"] -.-> V
  O -.->|"every run on it"| LG["ledger/<br/>each run, chained,<br/>never rewritten"]`;

const trailSteps = [
  { label: 'origin/', detail: 'your words, never edited' },
  { label: 'structure.md', detail: 'the point, cut three ways' },
  { label: 'versions/ and image/', detail: 'each version and the print, each with its why' },
  {
    label: 'sources.md and road.md',
    detail: 'every claim’s link; who ran, in what order, told what',
  },
  { label: 'feedback/', detail: 'your notes on the output, which rework the versions' },
  { label: 'ledger/', detail: 'every run on the thought, chained, never rewritten' },
];
---

<Page
  title="How it works"
  description="Talk or paste a thought; a team of AI agents makes it a complete blog post that keeps your words, shows every change and why, and names its sources. Nothing goes live without you."
  width="wide"
>
  <section class="hero frame" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="label">How it works</p>
      <h1 id="hero-title">Talk it out. Publish something you can stand behind.</h1>
      <p class="lead">
        Say what you think, or paste what you wrote. A small team of AI agents tidies it into a
        clear, well-made post that keeps your words, shows what changed and why, and names its
        sources. Nothing goes live until you say so.
      </p>
      <div class="actions">
        <a class="control filled" href="#proof">See a real one</a>
        <a class="control" href="#tour">Hear the tour</a>
        <a class="control" href="#film">Watch the minute</a>
      </div>
    </div>
    <figure class="hero-print">
      <Image
        src={cover}
        alt="Hands hold one sheet of paper: one holds a microphone to it, one a rubber stamp above it."
        width={560}
        height={560}
        loading="eager"
      />
      <figcaption class="small quiet">
        Every post gets a linocut print. This one is the route: your words go in, many hands work on
        the page, and you hold the stamp.
      </figcaption>
    </figure>
  </section>

  <section class="frame" id="film" aria-labelledby="film-title">
    <p class="label">The pitch</p>
    <h2 id="film-title">The whole idea in one minute</h2>
    <!-- Made by scripts/pitch from the real site; the voice and music are listed in docs/audio-sources.md. -->
    <video
      class="film"
      controls
      playsinline
      preload="none"
      poster="/media/pitch.jpg"
      width="1920"
      height="1080"
    >
      <source src="/media/pitch.mp4" type="video/mp4" />
      <track kind="captions" src="/media/pitch.vtt" srclang="en" label="English" default />
    </video>
  </section>

  <section class="frame" id="proof" aria-labelledby="proof-title">
    <p class="label">A real one</p>
    <h2 id="proof-title">What was written, and what was published</h2>
    <div class="proof">
      <div class="said-raw">
        <p class="side-label">As it was typed, untouched</p>
        <blockquote>
          {said.map((line) => <p>{line}</p>)}
        </blockquote>
      </div>
      <div class="said-tidy">
        <p class="side-label">The message it became</p>
        <p class="message"><mark>{message}</mark></p>
      </div>
    </div>
    <div class="cuts">
      <p class="side-label">And what was left out, in its own words</p>
      <p>{cuts}</p>
    </div>
    <div class="actions">
      <a class="control" href={`/thoughts/${proofSlug}`}>Read the post</a>
      <a class="control" href={`/thoughts/${proofSlug}/origin`}>Open the original</a>
    </div>
  </section>

  <section class="frame" id="run" aria-labelledby="run-title">
    <p class="label">A real run</p>
    <h2 id="run-title">Watch one thought go the whole way</h2>
    <div class="intro">
      <p>
        This is <a href={`/thoughts/${runSlug}`}>Same idea, a year later</a>, the first post that
        went down the whole route by itself. {agentSteps.length} agents, each one starting as soon as
        the work it needs is ready. The route stopped {inWords(replay.asked)} times for {person}: to
        answer the interview, to approve the message, and to approve the merge. Steps that did not
        finish were run again from where they stopped, without starting over.
      </p>
      <p>
        The picture is the one the studio draws while the agents work, played back from the post's
        own ledger. Round steps are {person}'s calls.
      </p>
    </div>
    <RouteReplay
      client:visible
      layout={replay.layout}
      frames={replay.frames}
      label={`The route of “Same idea, a year later”, step by step`}
      ending={`Finished in ${runTook}: ${inWords(replay.asked)} calls by ${person}, and ${inWords(replay.again)} runs that did not finish, run again. Press Play to watch it from the start.`}
    />
    <div class="actions">
      <a class="control" href={`/thoughts/${runSlug}`}>Read the post</a>
      <a class="control" href={`${repo}/tree/main/thoughts/${runSlug}/ledger`}
        >Its ledger, run by run</a
      >
    </div>
  </section>

  <section class="frame" id="pitch" aria-labelledby="pitch-title">
    <p class="label">What changes</p>
    <h2 id="pitch-title">Say more, type less, and show your working</h2>
    <div class="compare">
      <div class="side">
        <p class="side-label">Writing it yourself</p>
        <ul>
          <li>The idea arrives on a walk and is gone by the time you sit down.</li>
          <li>A blank page, an evening, and a post that sounds like everyone else's.</li>
          <li>Readers can't tell what you said from what a tool added.</li>
          <li>A claim with nothing behind it.</li>
          <li>Older posts sink, and nobody sees how the ideas connect.</li>
          <li>Readers who would rather listen can't.</li>
        </ul>
      </div>
      <div class="side after">
        <p class="side-label">Talking it out here</p>
        <ul>
          <li>A few minutes of talking, a few answers, one read-through.</li>
          <li>A post in your own voice, learned from your own words.</li>
          <li>A switch to the original on every post, and a note on every change.</li>
          <li>Every claim with a source, checked before it goes out.</li>
          <li>
            Every small idea on <a href="/graph">one graph</a>, each linked to the paragraph that
            says it.
          </li>
          <li>A post you can listen to, the words lighting up as they are said.</li>
        </ul>
      </div>
    </div>
    <ul class="promises">
      <li>
        <p class="promise">Your words, kept</p>
        <p>The original stays exactly as it came out, one switch away on every post.</p>
      </li>
      <li>
        <p class="promise">Every change has a why</p>
        <p>Each file says why it was written that way. Without one, nothing is built.</p>
      </li>
      <li>
        <p class="promise">You press publish</p>
        <p>The agents only ever propose. You read it, and you decide.</p>
      </li>
    </ul>
  </section>

  <section class="frame" id="tour" aria-labelledby="tour-title">
    <p class="label">The tour</p>
    <h2 id="tour-title">From a voice note to a post, in {tour.length} stations</h2>
    <p class="intro">
      Press Play to hear it, or step through it yourself with the arrow keys. Every word the voice
      says is on screen, and the word being said is underlined, as on a post read aloud.
    </p>
    <Tour client:visible stations={slides} />
    <p class="small quiet">
      Read word for word by an AI voice, {settings.media.voice_name ?? settings.site.author}, made
      with ElevenLabs, as the posts are. How each clip was made is written down in <a
        href={`${repo}/blob/main/docs/audio-sources.md`}>docs/audio-sources.md</a
      >.
    </p>
  </section>

  <section class="frame" id="underneath" aria-labelledby="underneath-title">
    <p class="label">Everything underneath</p>
    <h2 id="underneath-title">For anyone who wants to check</h2>
    <p class="intro">
      Nothing here is hidden. Open any part to see the agents, the route a post takes, the files it
      leaves behind and every service it uses.
    </p>

    <details class="layer" id="agents">
      <summary>
        <span class="layer-name">The agents</span>
        <span class="quiet">{roster.length} of them, one job each</span>
      </summary>
      <div class="layer-body">
        <p class="intro">
          Each agent does one thing, reads the blogger's profile first, and writes its why at the
          top of everything it makes. Two of them can only say no. This list is read from the
          agents' own instructions every time the site is built.
        </p>
        {
          byPhase.map((p) => (
            <div class="phase">
              <h3>
                <span class="quiet">Phase {p.n}</span> {p.name}
              </h3>
              <ul class="roster">
                {p.agents.map((a) => (
                  <li>
                    <details>
                      <summary>
                        <b>{a.name}</b>
                        <span>{firstSentence(a.why)}</span>
                        {a.canHold && <span class="tag">Can stop a post</span>}
                      </summary>
                      <div class="more">
                        <p>{a.why}</p>
                        <dl>
                          <dt>Reads</dt>
                          <dd>
                            {a.reads.map((r) => (
                              <code>{r}</code>
                            ))}
                          </dd>
                          <dt>Writes</dt>
                          <dd>
                            {a.writes.map((w) => (
                              <code>{w}</code>
                            ))}
                          </dd>
                        </dl>
                        <a class="control" href={`${repo}/blob/main/agents/${a.name}/PROMPT.md`}>
                          Its instructions, word for word
                        </a>
                      </div>
                    </details>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>

    <details class="layer" id="route">
      <summary>
        <span class="layer-name">The route</span>
        <span class="quiet">who goes when, and who decides</span>
      </summary>
      <div class="layer-body">
        <p class="intro">
          There is no hidden pipeline. The route is written down in one file, <a
            href={`${repo}/blob/main/roadbook.config.ts`}><code>roadbook.config.ts</code></a
          >, and the picture of <a href="#run">the real run</a> above is drawn from it: {
            replay.layout.steps.length
          } steps, {inWords(gateSteps.length)} of them a person's call. Every agent runs on GitHub, on
          the thought's own pull request, and commits what it made there.
        </p>
        <table>
          <thead>
            <tr><th scope="col">You do this</th><th scope="col">This happens</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Record or paste in the studio</td>
              <td>
                A pull request opens with your words, unedited, as the origin, and the interview
                agent starts on it by itself. While you talk, the studio shows your words as they
                are heard
              </td>
            </tr>
            <tr>
              <td>Nothing: an agent finishes</td>
              <td>
                Every step that waits on it starts by itself, once everything it needs is ready and
                up to date. Where two steps join, the next one waits for both
              </td>
            </tr>
            <tr>
              <td>Answer the questions, approve the message</td>
              <td>
                Each waits in the studio as Needs you, by voice or in writing. Only a person can
                close it; an agent that tries is refused. Your answer starts the next agents
              </td>
            </tr>
            <tr>
              <td>An agent holds</td>
              <td>Its reason is committed and the check fails, so nothing merges by accident</td>
            </tr>
            <tr>
              <td>A step does not finish</td>
              <td>
                The studio shows where it stopped. Run again starts that one step, not the route
              </td>
            </tr>
            <tr>
              <td>Open the studio</td>
              <td>
                Every thought's route as it happens: the step working now in marigold and moving,
                what is waiting on you, and what each run cost
              </td>
            </tr>
            <tr>
              <td>Approve and merge</td>
              <td>
                Only once every check has passed and nothing holds. The post goes live, and the
                ledger records who pressed it. Nothing else can publish
              </td>
            </tr>
            <tr>
              <td>Record a note about the output</td>
              <td>The feedback agent reworks only what the note is about</td>
            </tr>
          </tbody>
        </table>
        <h3 class="sub">Why it runs by itself, and still waits for you</h3>
        <div class="prose">
          <p>
            It began with a label per agent, added by hand. That made every run easy to trust and
            slow to get through. Now each agent starts itself, but nothing else changed: every run
            is still a commit you can read, with the agent's name on it and its why at the top of
            every file it wrote, and the route still stops where only you can decide. If a step goes
            wrong, you run that step again, without starting over. A label still runs any one agent
            by hand.
          </p>
          <p>
            A run that would take the month past its budget is not started. The profile agent learns
            in the background, from your words and from what you change in review; it only ever
            proposes, as its own pull request. The last step never changes: a person approves the
            merge.
          </p>
        </div>
      </div>
    </details>

    <details class="layer" id="trail">
      <summary>
        <span class="layer-name">The paper trail</span>
        <span class="quiet">what every post carries</span>
      </summary>
      <div class="layer-body">
        <p class="intro">
          A post is a folder, not just a page. Everything an agent read, wrote or was told is in it,
          each file with a reason at the top. Every run is also written to the thought's ledger, and
          a post the agents have worked on ends with a short "How this was made" read from it.
        </p>
        <FlowChart
          source={trail}
          caption="One folder per thought. The origin is never edited: a correction is a new origin."
          steps={trailSteps}
        />
        <table>
          <thead>
            <tr><th scope="col">File</th><th scope="col">What it proves</th></tr>
          </thead>
          <tbody>
            <tr><td><code>origin/</code></td><td>What you actually said, before any tidying</td></tr
            >
            <tr
              ><td><code>structure.md</code></td><td>What the point was taken to be, and why</td
              ></tr
            >
            <tr>
              <td><code>versions/</code></td>
              <td>Each version, which origin it came from, what changed and why</td>
            </tr>
            <tr>
              <td><code>sources.md</code></td><td
                >Where each claim comes from, and that it was checked</td
              >
            </tr>
            <tr
              ><td><code>image/</code></td><td
                >The drawing and the exact prompt it was drawn from</td
              ></tr
            >
            <tr
              ><td><code>road.md</code></td><td
                >Which agents ran, in which order, with which instructions</td
              ></tr
            >
            <tr
              ><td><code>feedback/</code></td><td>What you asked to change after reading it</td></tr
            >
            <tr>
              <td><code>ledger/</code></td>
              <td>
                Every run: which agent, how it ended, what it wrote and what it cost, and every call
                a person made: who answered or approved, and when. Each entry is chained to the one
                before, and a check on every pull request refuses one that changes or removes a run
                already merged
              </td>
            </tr>
          </tbody>
        </table>
        <a class="control" href={`${repo}/tree/main/thoughts/${proofSlug}`}
          >See the whole folder for the post above</a
        >
      </div>
    </details>

    <details class="layer" id="sources">
      <summary>
        <span class="layer-name">What it uses</span>
        <span class="quiet">every source and service, and where it is written down</span>
      </summary>
      <div class="layer-body">
        <p class="intro">
          Your words are the only facts a post starts from. Everything else it leans on is listed
          here. Every call to a paid service is priced before it is made: a model with no known
          price is refused, each agent has a budget per run, and the studio shows the month's spend
          against the budget.
        </p>
        <table>
          <thead>
            <tr>
              <th scope="col">Source</th><th scope="col">What it is for</th><th scope="col"
                >Written down in</th
              >
            </tr>
          </thead>
          <tbody>
            <tr
              ><td>Your voice or text</td><td>The thought itself</td><td><code>origin/</code></td
              ></tr
            >
            <tr>
              <td>Your answers</td><td>The context a stranger needs</td><td
                ><code>origin/answers.md</code></td
              >
            </tr>
            <tr>
              <td>Your profile</td><td>How you talk; every agent reads it first</td><td
                ><code>profile.md</code></td
              >
            </tr>
            <tr>
              <td>Site settings</td>
              <td>Name, languages, themes, the drawing style, the publish switch</td>
              <td><code>settings.yml</code></td>
            </tr>
            <tr>
              <td>Claude, by Anthropic</td>
              <td>The thinking agents, a review of every drawing, and the answers in the Ask box</td
              >
              <td><code>ledger/</code>, <code>settings.yml</code></td>
            </tr>
            <tr>
              <td>The web, through Claude's search</td>
              <td>A source for each claim, and the wiki pages</td>
              <td><code>sources.md</code>, <code>wiki/</code></td>
            </tr>
            <tr>
              <td>Workers AI, by Cloudflare</td><td
                >Turning the voice note into text, and showing your words while you talk (Deepgram's
                Nova-3)</td
              ><td>The origin pull request</td>
            </tr>
            <tr>
              <td>OpenAI's image model</td><td>The linocut drawings</td><td
                ><code>image/prompts.md</code></td
              >
            </tr>
            <tr>
              <td>ElevenLabs</td><td
                >The voice that reads each post aloud, and the voice on the tour</td
              ><td><code>settings.yml</code>, <code>docs/audio-sources.md</code></td>
            </tr>
            <tr>
              <td>Cloudflare</td><td
                >Hosting, the audio store, the studio's sign-in, the database for comments and live
                runs, and the spam check on comments</td
              ><td><code>site/wrangler.toml</code></td>
            </tr>
            <tr>
              <td>GitHub</td><td>Every pull request and every agent run</td><td
                >The repository's history</td
              >
            </tr>
            <tr>
              <td>The price list</td><td>What each model call costs, before it is made</td><td
                ><code>agents/_lib/prices.ts</code></td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </details>

    <details class="layer" id="road">
      <summary>
        <span class="layer-name">Why it is built this way</span>
        <span class="quiet">the long version</span>
      </summary>
      <div class="layer-body prose">
        <p>
          Most of what people think never gets written down. Not because it isn't worth reading, but
          because writing it properly takes an evening nobody has. Talking takes two minutes. The
          gap between the two is where this blog lives.
        </p>
        <p>
          AI can already turn a ramble into a tidy post. The trouble is what you lose: you can't
          tell any more what the person said and what the machine added, which claims are theirs,
          and which ones it made up with confidence. A post you can't check is a post you can't
          trust, however well it reads.
        </p>
        <p>
          So the rule here is the other way round. The thought is kept first, exactly as it came
          out, and never edited. Everything after it is a version that points back to it, and every
          file a version is made of starts with why it was made that way.
        </p>
        <p>
          The work is split between small agents, one job each, because a small job is easy to check
          and easy to fix. Each reads the same profile of how the blogger talks, so the post sounds
          like a person and not like the average of the internet. Every post can be read at three
          depths: the message in a few lines, the idea on one screen, and the road, with everything
          behind it.
        </p>
        <p>
          And at the end there is always a person. When the output goes the wrong way, the blogger
          says so out loud, and the post is reworked. When the same complaint comes three times, the
          instructions that caused it are changed. The complaint fixes the post; the pattern of
          complaints fixes the machine.
        </p>
      </div>
    </details>
  </section>

  <section class="close frame" aria-labelledby="close-title">
    <h2 id="close-title">Want one for your own thoughts?</h2>
    <p class="lead">
      The engine is open source. Run it yourself, or get in touch about setting it up for you or
      your team.
    </p>
    <div class="actions">
      <a class="control filled" href={`mailto:${settings.site.email}?subject=The%20agentic%20blog`}
        >Get in touch</a
      >
      <a class="control" href={repo}>The code on GitHub</a>
    </div>
  </section>
</Page>


---
// Why: the studio is where an origin begins. One button to talk, one to talk back about an output, and
// below them what the agents wrote that Victor has not read yet, so nothing waits unseen. Cloudflare
// Access sits in front of /studio and /api/*; this page never indexes.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import { Recorder } from '../islands/Recorder';
import { FeedbackStudio } from '../islands/FeedbackStudio';
import { ReviewList } from '../islands/ReviewList';
import { CommentsReview } from '../islands/CommentsReview';
import { settings } from '../lib/settings';
import { leafOf, thoughtSlugOf } from '../lib/content';
import { waitingForReview } from '../lib/review';

// Drafts too: the structure agent opens every thought as a draft, and its versions wait for review then.
const thoughts = (await getCollection('thoughts')).map((t) => ({
  slug: thoughtSlugOf(t.id),
  title: t.data.title,
  date: t.data.date,
  draft: t.data.draft,
}));
const versions = (await getCollection('versions')).map((v) => ({
  slug: thoughtSlugOf(v.id),
  leaf: leafOf(v.id),
  kind: v.data.kind,
  reviewed: v.data.reviewed,
}));
const sources = (await getCollection('sources')).map((s) => ({
  slug: thoughtSlugOf(s.id),
  reviewed: s.data.reviewed,
}));
const waiting = waitingForReview(thoughts, versions, sources);
---

<Page title="Studio" description="A private room to talk in." noindex={true}>
  <h1>Studio</h1>
  <p class="quiet">
    Talk. Don't tidy. What you say here is kept exactly as it comes out, and becomes an origin that
    every conversion will point back to. When the thought already exists as text, write or paste it
    instead; it is kept the same way.
  </p>

  <Recorder client:load mode="origin" />

  <h2>Talk back</h2>
  <p class="quiet">
    When an output went down the wrong road, say so here instead of editing sentences. Name the
    thought first.
  </p>
  <FeedbackStudio client:visible />

  <section class="review" aria-labelledby="review-label">
    <h2 class="label" id="review-label">Waiting for your review</h2>
    <ReviewList client:load waiting={waiting} />
  </section>

  <section class="review" aria-labelledby="comments-label">
    <h2 class="label" id="comments-label">Comments waiting</h2>
    <CommentsReview client:visible status="pending" />
  </section>

  <section class="review" aria-labelledby="comments-shown-label">
    <h2 class="label" id="comments-shown-label">Comments showing</h2>
    <p class="small quiet">Approved by mistake? Delete it here and it leaves the post at once.</p>
    <CommentsReview client:visible status="approved" />
  </section>

  <p class="small quiet">
    Signed in as {settings.site.author}. This page is behind Cloudflare Access and is never indexed.
  </p>
</Page>

<style is:global>
  .review {
    margin-top: var(--space-6);
  }
  .review-list > p {
    margin-top: var(--space-3);
  }
  .review .thought {
    margin: var(--space-4) 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .review .thought legend {
    padding: 0;
    font-weight: 700;
  }
  .review .thought ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    max-width: none;
  }
  .review .thought li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    padding-block: var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .review .thought input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--ink);
  }
  .review .thought label {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .review .thought code {
    color: var(--quiet);
    overflow-wrap: anywhere;
  }
  .review .read {
    font-size: var(--size-small);
  }
  .review .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .review .status {
    min-height: 1.6em;
    margin-top: var(--space-2);
  }
  .comments-review ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: none;
  }
  .comments-review li {
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .comments-review p {
    margin: 0;
    max-width: none;
  }
  .comments-review .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .comments-review .text {
    margin-top: var(--space-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-width: var(--measure);
  }
  .comments-review .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>

<style is:global>
  .recorder {
    margin: var(--space-4) 0 var(--space-6);
  }
  .recorder .big {
    width: 100%;
    min-height: calc(var(--tap) * 3);
    font-size: var(--size-message);
    font-weight: 700;
    border-width: 2px;
  }
  .recorder .alternative {
    margin-top: var(--space-2);
  }
  .recorder .elapsed {
    font-size: var(--size-title);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--space-3);
  }
  .recorder .transcript {
    white-space: pre-wrap;
  }
  .recorder .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .recorder form .field + p {
    margin-top: var(--space-2);
  }
  .recorder form .row {
    margin-top: var(--space-3);
  }
</style>

---
// Why: one page per topic: what the topic means in one plain line, then every post that carries it, in the
// same ruled index as every other list but with each post's print, and the other topics beside it (on a
// phone, under the heading). The label above the name links back to all the topics. A topic with no
// published post has no page, so a reader never lands on an empty list.
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ListHead from '../../components/ListHead.astro';
import ThoughtIndex from '../../components/ThoughtIndex.astro';
import TopicStrip from '../../components/TopicStrip.astro';
import TopicsAside from '../../components/TopicsAside.astro';
import { thoughtNumbers } from '../../lib/content';
import { themeCounts, thoughtsLabel } from '../../lib/themes';
import { topicAbout, topicName } from '../../lib/topic-name';

export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts', ({ data }) => !data.draft);
  return themeCounts(thoughts.map((t) => t.data.themes)).map(([topic]) => ({ params: { topic } }));
}

const { topic } = Astro.params;
const all = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
);
const thoughts = all.filter((t) => t.data.themes.includes(topic));
const label = topicName(topic);
const about = topicAbout(topic);
const count = `${thoughtsLabel(thoughts.length)} so far.`;
---

<Page
  title={`${label} — Topics`}
  description={about ?? `Every thought about ${label.toLowerCase()}.`}
  width="wide"
>
  <ListHead
    parent={{ href: '/topics', name: 'Topics' }}
    label={label}
    title={label}
    note={about ? `${about} ${count}` : count}
  />
  <TopicStrip thoughts={all} current={topic} />
  <div class="frame body">
    <section class="main" aria-labelledby="topic-list">
      <h2 class="label" id="topic-list">Thoughts on {label.toLowerCase()}</h2>
      <ThoughtIndex
        thoughts={thoughts}
        numbers={thoughtNumbers(all)}
        prints={true}
        current={topic}
      />
    </section>
    <TopicsAside thoughts={all} current={topic} />
  </div>
</Page>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--space-6);
    padding-top: var(--space-5);
  }
  .main {
    min-width: 0;
  }
  @media (max-width: 61rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// Why: the header and footer offer Topics as a way to read, so there is one page that lists them all. It is
// an index of topics, not of posts: one ruled row per topic, most written about first, with its name as the
// one marigold mark (the thing being chosen here), how many thoughts carry it, and one plain line of what it
// is about, from settings.yml. One link per row. The posts themselves live on each topic's page.
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ListHead from '../../components/ListHead.astro';
import { settings } from '../../lib/settings';
import { themeCounts, thoughtsLabel } from '../../lib/themes';
import { topicName } from '../../lib/topic-name';

const all = await getCollection('thoughts', ({ data }) => !data.draft);
const topics = themeCounts(all.map((t) => t.data.themes));
const note =
  topics.length === 1
    ? 'One topic so far.'
    : `${String(topics.length)} topics, the most written about first.`;
---

<Page
  title="Topics"
  description="Every topic the thoughts cover, and what each one is about."
  width="wide"
>
  <ListHead label="Topics" title="What the thoughts are about" note={note} />
  <div class="frame body">
    {topics.length === 0 && <p class="quiet">No thoughts published yet, so no topics either.</p>}
    {
      topics.length > 0 && (
        <section aria-labelledby="topics-label">
          <h2 class="label" id="topics-label">
            Every topic
          </h2>
          <ol class="topics">
            {topics.map(([topic, count]) => (
              <li>
                <h3>
                  <a href={`/topics/${topic}`}>
                    <mark>{topicName(topic)}</mark>
                  </a>
                </h3>
                <p class="small quiet count">{thoughtsLabel(count)}</p>
                {settings.topics[topic] && <p class="describe">{settings.topics[topic]}</p>}
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</Page>

<style>
  .body {
    padding-top: var(--space-5);
  }
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    grid-template-areas:
      'name about'
      'count about';
    gap: var(--space-1) var(--space-5);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  h3 {
    grid-area: name;
    margin: 0;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  h3 a {
    text-decoration: none;
  }
  mark {
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0.05em 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  h3 a:hover mark,
  h3 a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
  }
  p {
    margin: 0;
  }
  .count {
    grid-area: count;
  }
  .describe {
    grid-area: about;
    font-size: 1.1875rem;
  }

  @media (max-width: 48rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'name' 'count' 'about';
    }
    .describe {
      margin-top: var(--space-2);
    }
  }
</style>

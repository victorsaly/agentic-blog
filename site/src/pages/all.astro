---
// Why: the home page shows the newest ten; this page lists every published thought, newest first, so
// nothing older is ever out of reach.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ThoughtList from '../components/ThoughtList.astro';
import ThemeNav from '../components/ThemeNav.astro';

const thoughts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Page title="All thoughts" description="Every published thought, newest first.">
  <h1>All thoughts</h1>
  <ThemeNav thoughts={thoughts} />
  <ThoughtList thoughts={thoughts} />
</Page>

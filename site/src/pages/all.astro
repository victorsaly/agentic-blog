---
// Why: the home page shows the newest ten; this page lists every published thought, newest first, so
// nothing older is ever out of reach. It uses the same ruled index as every list on the site, grouped by
// year, with a link to each year once there are enough thoughts to need one, and the topics beside it (on a
// phone, under the heading) to narrow the list.
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import ListHead from '../components/ListHead.astro';
import ThoughtIndex from '../components/ThoughtIndex.astro';
import TopicStrip from '../components/TopicStrip.astro';
import TopicsAside from '../components/TopicsAside.astro';
import { newestFirst } from '../lib/content';
import { settings } from '../lib/settings';
import { thoughtsLabel } from '../lib/themes';

const thoughts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(newestFirst);
const yearOf = (date: Date): string =>
  new Intl.DateTimeFormat('en-GB', { year: 'numeric', timeZone: settings.site.timezone }).format(
    date,
  );
const years: { year: string; list: typeof thoughts }[] = [];
for (const t of thoughts) {
  const year = yearOf(t.data.date);
  const last = years.at(-1);
  if (last?.year === year) last.list.push(t);
  else years.push({ year, list: [t] });
}
// A list short enough to scroll needs no jump links; the counts per year matter only when there are years.
const JUMP_FROM = 10;
const showJump = years.length > 1 && thoughts.length >= JUMP_FROM;
---

<Page title="Archive" description="Every published thought, newest first." width="wide">
  <ListHead
    label="Archive"
    title="Every thought"
    note={`${thoughtsLabel(thoughts.length)}, newest first.`}
  />
  <TopicStrip thoughts={thoughts} />
  <div class="frame body with-side">
    <div class="main">
      {thoughts.length === 0 && <p class="quiet">Nothing published yet.</p>}
      {
        showJump && (
          <nav class="years" aria-label="Jump to a year">
            <ul>
              {years.map(({ year }) => (
                <li>
                  <a href={`#year-${year}`}>{year}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        years.map(({ year, list }) => (
          <section aria-labelledby={`year-${year}`}>
            <h2 class="label" id={`year-${year}`}>
              {year}
              {years.length > 1 && <span class="quiet">{thoughtsLabel(list.length)}</span>}
            </h2>
            <ThoughtIndex thoughts={list} />
          </section>
        ))
      }
    </div>
    <TopicsAside thoughts={thoughts} />
  </div>
</Page>

<style>
  .body {
    padding-top: var(--space-5);
  }
  .main {
    min-width: 0;
  }
  .years ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    max-width: none;
    width: fit-content;
    border-right: var(--rule-width) solid var(--ink);
  }
  .years a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 0.75rem;
    border-left: var(--rule-width) solid var(--ink);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .years a:hover {
    text-decoration: underline;
  }
  section {
    scroll-margin-top: 5rem;
  }
  section + section {
    margin-top: var(--space-6);
  }
  .label .quiet {
    margin-left: var(--space-2);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }
</style>

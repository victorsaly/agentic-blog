---
// Why: the footer closes every page with the one line the blog stands on, set large under a heavy rule,
// then what the blog is for in plain words, and the links a reader expects at the bottom of a blog: the
// ways to read, the feed, and where the code lives, so the road is never hidden. The bottom line carries
// the licence and, quietly, the door to the studio: the signed-in room where the author talks a new thought
// in, shown so readers can see where posts are made. The Agentic Blog mark is inlined so it is drawn in
// the page's own ink, light or dark; its standalone <style> is dropped. The link's name is its visible
// words, so a screen reader and a voice user say the same thing.
import { settings } from '../lib/settings';
import markRaw from '../assets/logo/mark.svg?raw';

const mark = markRaw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace('role="img" aria-label="Agentic Blog"', 'aria-hidden="true" focusable="false"');

const licence =
  settings.licence.content === 'all-rights-reserved'
    ? 'all rights reserved'
    : settings.licence.content;
---

<footer class="site-footer">
  <div class="frame top">
    <div class="line">
      <a class="brand" href="/"
        ><Fragment set:html={mark} /><span
          ><b>Agentic</b><span class="visually-hidden"> </span><i>Blog</i></span
        ></a
      >
      <p class="tagline">{settings.site.tagline}.</p>
      <p class="small quiet">
        Every post starts as a real thought, spoken or written, kept as it came out. AI helps tidy
        it and give it structure, so you can say what you think freely and still publish something
        clear and well documented. The engine is open: <a
          href="https://github.com/victorsaly/agentic-blog">agentic-blog on GitHub</a
        >.
      </p>
    </div>
    <nav aria-labelledby="footer-read">
      <p class="head" id="footer-read">Read</p>
      <ul>
        <li><a href="/">Thoughts</a></li>
        <li><a href="/topics">Topics</a></li>
        <li><a href="/all">Archive</a></li>
        <li><a href="/search">Search</a></li>
        <li><a href="/how-it-works">How it works</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-follow">
      <p class="head" id="footer-follow">Follow</p>
      <ul>
        <li><a href="/rss.xml">RSS feed</a></li>
        {
          settings.site.linkedin && (
            <li>
              <a href={settings.site.linkedin} rel="me">
                LinkedIn
              </a>
            </li>
          )
        }
        <li><a href="https://github.com/victorsaly/agentic-blog">GitHub</a></li>
      </ul>
    </nav>
  </div>
  <div class="base">
    <div class="frame small quiet">
      <p>Words and drawings: {licence}. Code: {settings.licence.code}.</p>
      <a class="studio" href="/studio" rel="nofollow">Studio, for the author</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-heavy) solid var(--ink);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-5);
  }
  .line {
    flex: 2 1 22rem;
    min-width: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    margin-bottom: var(--space-3);
    font-size: var(--size-h2);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
  }
  .brand :global(svg) {
    height: 1.4em;
    width: auto;
  }
  .brand b {
    font-weight: 700;
  }
  .brand i {
    font-weight: 400;
  }
  .brand:hover span {
    text-decoration: underline;
  }
  .tagline {
    margin: 0 0 var(--space-3);
    max-width: 14ch;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .line .small {
    margin: 0;
    max-width: 28rem;
  }
  nav {
    flex: 1 1 10rem;
  }
  .head {
    margin: 0 0 var(--space-2);
    font-size: var(--size-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .base {
    border-top: var(--rule-width) solid var(--ink);
  }
  .base .frame {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
  }
  .base p {
    margin: 0;
  }
  .studio {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>

---
// Why: the archive and each topic page are wide like the home page, so the list sits in the main column
// and this side column offers the other ways in: every topic with how many posts carry it (the one you are
// on marked, for screen readers too, and the count said with its unit), a way back to all the topics from a
// topic page, and the feed. Ruled rows, the same as the home page's. On a phone the topics move to the strip
// under the heading (TopicStrip), so here they show on a desk only.
import type { CollectionEntry } from 'astro:content';
import { themeCounts } from '../lib/themes';
import { topicName } from '../lib/topic-name';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
  current?: string;
}

const { thoughts, current } = Astro.props;
const counts = themeCounts(thoughts.map((t) => t.data.themes));
---

<aside class="side" aria-label="Topics and the feed">
  {
    counts.length > 0 && (
      <nav class="topics" aria-labelledby="aside-topics">
        <h2 class="label" id="aside-topics">
          Topics
        </h2>
        <ul class="rows">
          {counts.map(([topic, count]) => (
            <li>
              <a href={`/topics/${topic}`} aria-current={current === topic ? 'page' : undefined}>
                <span class="name">{topicName(topic)}</span>
                <span class="quiet">
                  {count}
                  <span class="visually-hidden">{count === 1 ? ' thought' : ' thoughts'}</span>
                </span>
              </a>
            </li>
          ))}
          {current !== undefined && (
            <li>
              <a href="/topics">
                <span class="name">All topics</span>
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
  <section>
    <h2 class="label">Follow</h2>
    <ul class="rows">
      <li><a href="/rss.xml"><span class="name">RSS feed</span></a></li>
    </ul>
  </section>
</aside>

<style>
  .side {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .label {
    margin-top: 0;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .rows li {
    border-bottom: var(--rule-width) solid var(--ink);
  }
  .rows a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3rem;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .rows a:hover .name {
    text-decoration: underline;
  }
  /* The topic you are on: its name, not its count, carries the mark. */
  .rows a[aria-current='page'] .name {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: var(--rule-strong);
    text-underline-offset: 6px;
  }
  @media (max-width: 61rem) {
    .topics {
      display: none;
    }
  }
</style>

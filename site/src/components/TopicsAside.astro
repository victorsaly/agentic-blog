---
// Why: the archive and each topic page are wide like the home page, so the list sits in the main column
// and this side column offers the other ways in: every topic with how many posts carry it (the one you are
// on marked, for screen readers too, and the count said with its unit), a way back to all the topics from a
// topic page, and the feed. Ruled rows, the same as the home page's. Once the column drops below the list the
// topics move to the strip under the heading (TopicStrip), so here they show beside the list only.
import type { CollectionEntry } from 'astro:content';
import TopicLink from './TopicLink.astro';
import { themeCounts } from '../lib/themes';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
  current?: string;
}

const { thoughts, current } = Astro.props;
const counts = themeCounts(thoughts.map((t) => t.data.themes));
---

<aside class="side" aria-label="Topics and the feed">
  {
    counts.length > 0 && (
      <nav class="when-beside" aria-labelledby="aside-topics">
        <h2 class="label" id="aside-topics">
          Topics
        </h2>
        <ul class="rows">
          {counts.map(([topic, count]) => (
            <li>
              <TopicLink topic={topic} count={count} current={current} />
            </li>
          ))}
          {current !== undefined && (
            <li>
              <a href="/topics">
                <span class="name">All topics</span>
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
  <section>
    <h2 class="label">Follow</h2>
    <ul class="rows">
      <li><a href="/rss.xml"><span class="name">RSS feed</span></a></li>
    </ul>
  </section>
</aside>

<style>
  .side {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .label {
    margin-top: 0;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .rows li {
    border-bottom: var(--rule-width) solid var(--ink);
  }
  .rows :global(a) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3rem;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .rows :global(a:hover .name) {
    text-decoration: underline;
  }
  /* The topic you are on: its name, not its count, carries the mark. */
  .rows :global(a[aria-current='page'] .name) {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: var(--rule-strong);
    text-underline-offset: 6px;
  }
</style>

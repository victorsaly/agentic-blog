---
// Why: the header is the site name, the two ways to find something (search the posts, ask about them), and
// two switches a reader may need before reading anything: the font for a dyslexic reader and the theme for a
// tired one. Search and Ask carry linocut icons with their words, so they read at a glance and to a screen
// reader alike. The graph will take the front door later.
import { Image } from 'astro:assets';
import { settings } from '../lib/settings';
import { AskPanel } from '../islands/AskPanel';
import searchIcon from '../assets/icons/search.png';
import askIcon from '../assets/icons/ask.png';

// The reader chat opens with the site: on when publishing.index is, and always in local development.
const chatOn = settings.publishing.index || import.meta.env.DEV;
---

<header>
  <a class="name" href="/">{settings.site.name}</a>
  <div class="switches">
    <a class="header-link" href="/search">
      <Image class="header-icon" src={searchIcon} alt="" width={24} height={24} />
      <span>Search</span>
    </a>
    {chatOn && <AskPanel client:idle iconSrc={askIcon.src} />}
    <!-- Each switch names what it turns on, in words, and says with aria-pressed whether it is on. -->
    <button type="button" id="font-switch" aria-pressed="false">
      <span class="glyph" aria-hidden="true">Aa</span>
      Lexend
    </button>
    <button type="button" id="theme-switch" aria-pressed="false">Dark</button>
  </div>
</header>

<style>
  header {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--space-3) var(--gutter) 0;
  }
  .name {
    font-weight: 700;
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .name:hover {
    text-decoration: underline;
  }
  .switches {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header-link,
  :global(.header-link) {
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .header-link:hover span,
  :global(.header-link:hover span),
  :global(.header-link:focus-visible span) {
    text-decoration: underline;
  }
  :global(.header-link:hover) {
    background: none;
    color: var(--ink);
  }
  :global(.header-icon) {
    width: 24px;
    height: 24px;
    filter: var(--drawing-filter);
  }
  @media (max-width: 30rem) {
    /* On a phone the icons carry the row; the words stay for screen readers. */
    .header-link span,
    :global(.header-link span) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-width: var(--tap);
    padding: 0 var(--space-2);
    font-size: var(--size-small);
  }
  .glyph {
    font-weight: 700;
  }
  @media (max-width: 30rem) {
    .glyph {
      display: none;
    }
  }
  button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  // Why: two toggles, stored per browser, restored by the layout before paint. No framework needed for this.
  const root = document.documentElement;
  const remember = (key: string, value: string | null): void => {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      /* private window or storage blocked: the switch still works for this page */
    }
  };

  const font = document.getElementById('font-switch');
  const syncFont = (): void => {
    font?.setAttribute('aria-pressed', String(root.dataset['font'] === 'switch'));
  };
  font?.addEventListener('click', () => {
    const on = root.dataset['font'] !== 'switch';
    if (on) root.dataset['font'] = 'switch';
    else delete root.dataset['font'];
    remember('font', on ? 'switch' : null);
    syncFont();
  });
  syncFont();

  const theme = document.getElementById('theme-switch');
  const prefersDark = (): boolean => matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = (): boolean =>
    root.dataset['theme'] === 'dark' || (root.dataset['theme'] === undefined && prefersDark());
  const syncTheme = (): void => {
    theme?.setAttribute('aria-pressed', String(isDark()));
  };
  theme?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset['theme'] = next;
    remember('theme', next);
    syncTheme();
  });
  syncTheme();
</script>

---
// Why: a post has up to four ways in, and the reader picks one at a time: the idea, where it came from,
// the whole road, and its sources. Tabs keep that choice in one row, each with a linocut icon so the row
// reads at a glance, in the order of the blog's thesis: the thought, its raw source, then the conversion.
// Without script every panel shows in order with its own heading, so nothing is lost; with script it is
// the standard tabs pattern (arrow keys, Home, End), and a link to a heading inside a panel opens it. The
// row is drawn as ruled cells, the chosen one filled black, and it tells the page which way is open.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Tab {
  id: string;
  name: string;
  hint: string;
  icon: ImageMetadata;
}

interface Props {
  tabs: Tab[];
  label: string;
}

const { tabs, label } = Astro.props;
---

<div class="post-tabs" id="ways-in" data-tabs>
  <div class="tablist" role="tablist" aria-label={label} hidden>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <Image class="icon" src={tab.icon} alt="" width={28} height={28} />
          <span class="words">
            <span class="name">{tab.name}</span>
            <span class="hint">{tab.hint}</span>
          </span>
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab) => (
      <section class="panel" id={tab.id} role="tabpanel" aria-labelledby={`tab-${tab.id}`}>
        <h2 class="panel-name">{tab.name}</h2>
        <slot name={tab.id} />
      </section>
    ))
  }
</div>

<style>
  .tablist {
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border-top: var(--rule-strong) solid var(--ink);
    border-bottom: var(--rule-width) solid var(--ink);
    margin: var(--space-5) 0 0;
  }
  .tablist:not([hidden]) {
    display: grid;
  }
  [role='tab'] {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 4.5rem;
    padding: 0 var(--space-3);
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  [role='tab'] + [role='tab'] {
    border-left: var(--rule-width) solid var(--ink);
  }
  [role='tab']:hover {
    background: var(--paper);
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    [role='tab']:hover {
      background: var(--hover);
    }
  }
  [role='tab'][aria-selected='true'],
  [role='tab'][aria-selected='true']:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .icon {
    width: 28px;
    height: 28px;
    flex: none;
    filter: var(--drawing-filter);
  }
  [aria-selected='true'] .icon {
    filter: var(--drawing-filter-on-ink);
  }
  .words {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-size: var(--size-body);
    line-height: var(--leading-tight);
  }
  [aria-selected='true'] .name {
    font-weight: 700;
  }
  .hint {
    font-size: 0.875rem;
    line-height: var(--leading-tight);
    color: var(--quiet);
    margin-top: var(--space-1);
  }
  [aria-selected='true'] .hint {
    color: var(--paper);
  }
  .panel-name {
    margin-top: var(--space-5);
  }
  /* Once the tabs work, the row names each panel, so the panel's own heading is for screen readers only. */
  .post-tabs.ready .panel-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .post-tabs.ready .panel[hidden] {
    display: none;
  }
  /* On a phone: two by two, names only. */
  @media (max-width: 40rem) {
    .tablist:not([hidden]) {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    [role='tab'] {
      min-height: 3.5rem;
      gap: var(--space-2);
      padding: 0 var(--space-2);
      border-bottom: var(--rule-width) solid var(--ink);
      margin-bottom: -1px;
    }
    [role='tab'] + [role='tab'] {
      border-left: 0;
    }
    [role='tab']:nth-child(even) {
      border-left: var(--rule-width) solid var(--ink);
    }
    .hint {
      display: none;
    }
  }
</style>

<script>
  // Why: the standard tabs pattern on top of panels that already work without it.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    if (!list || tabs.length === 0) continue;

    const select = (index: number, focus: boolean): void => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index]?.focus();
      root.dispatchEvent(
        new CustomEvent('tabchange', { detail: tabs[index]?.getAttribute('aria-controls') ?? '' }),
      );
    };

    // A link to a heading inside a panel (search results, the contents list) opens that panel first.
    const openForHash = (): void => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const target = document.getElementById(id);
      const index = panels.findIndex((p) => p && target && (p === target || p.contains(target)));
      if (index >= 0) {
        select(index, false);
        target?.scrollIntoView();
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(i, false);
        // The chosen way in lives in the address, so reload, Back and a shared link keep it.
        history.pushState(null, '', `#${tab.getAttribute('aria-controls') ?? ''}`);
      });
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === 'ArrowRight'
            ? (i + 1) % tabs.length
            : event.key === 'ArrowLeft'
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        select(next, true);
      });
    });

    list.hidden = false;
    root.classList.add('ready');
    select(0, false);
    openForHash();
    window.addEventListener('hashchange', openForHash);
  }
</script>

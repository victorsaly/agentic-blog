---
// Why: a post has up to four ways in, and the reader picks one at a time: the idea, where it came from,
// the whole road, and its sources. Tabs keep that choice in one row, each with a linocut icon so the row
// reads at a glance, in the order of the blog's thesis: the thought, its raw source, then the conversion.
// Without script every panel shows in order with its own heading, so nothing is lost; with script it is
// the standard tabs pattern (arrow keys, Home, End), and a link to a heading inside a panel opens it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Tab {
  id: string;
  name: string;
  hint: string;
  icon: ImageMetadata;
}

interface Props {
  tabs: Tab[];
  label: string;
}

const { tabs, label } = Astro.props;
---

<div class="post-tabs" id="ways-in" data-tabs>
  <div class="tablist" role="tablist" aria-label={label} hidden>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <Image class="icon" src={tab.icon} alt="" width={36} height={36} />
          <span class="name">{tab.name}</span>
          <span class="hint">{tab.hint}</span>
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab) => (
      <section class="panel" id={tab.id} role="tabpanel" aria-labelledby={`tab-${tab.id}`}>
        <h2 class="panel-name">{tab.name}</h2>
        <slot name={tab.id} />
        <p class="small back">
          <a href="#ways-in">Back to the top of this thought</a>
        </p>
      </section>
    ))
  }
</div>

<style>
  .tablist {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border-bottom: var(--rule-width) solid var(--rule);
    margin: var(--space-5) 0 var(--space-4);
  }
  .tablist:not([hidden]) {
    display: grid;
  }
  [role='tab'] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-1) var(--space-2);
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--quiet);
    font: inherit;
    cursor: pointer;
  }
  [role='tab']:hover {
    background: none;
    color: var(--ink);
  }
  [role='tab'][aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  [role='tab'][aria-selected='true'] .name {
    font-weight: 700;
  }
  .icon {
    width: 36px;
    height: 36px;
    filter: var(--drawing-filter);
    opacity: 0.55;
  }
  [aria-selected='true'] .icon,
  [role='tab']:hover .icon {
    opacity: 1;
  }
  /* A name that wraps keeps every hint on one line, at the foot of the row. */
  .name {
    flex: 1;
  }
  .hint {
    font-size: var(--size-small);
    color: var(--quiet);
  }
  .panel-name {
    margin-top: var(--space-5);
  }
  /* The way back up from the end of a long panel: a plain jump, no motion. */
  .back {
    margin: var(--space-5) 0 0;
  }
  /* Once the tabs work, the row names each panel, so the panel's own heading is for screen readers only. */
  .post-tabs.ready .panel-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .post-tabs.ready .panel[hidden] {
    display: none;
  }
  @media (max-width: 30rem) {
    .hint {
      display: none;
    }
    .name {
      font-size: var(--size-small);
      text-align: center;
    }
  }
</style>

<script>
  // Why: the standard tabs pattern on top of panels that already work without it.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    if (!list || tabs.length === 0) continue;

    const select = (index: number, focus: boolean): void => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index]?.focus();
    };

    // A link to a heading inside a panel (search results, the contents list) opens that panel first.
    const openForHash = (): void => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const target = document.getElementById(id);
      const index = panels.findIndex((p) => p && target && (p === target || p.contains(target)));
      if (index >= 0) {
        select(index, false);
        target?.scrollIntoView();
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(i, false);
        // The chosen way in lives in the address, so reload, Back and a shared link keep it.
        history.pushState(null, '', `#${tab.getAttribute('aria-controls') ?? ''}`);
      });
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === 'ArrowRight'
            ? (i + 1) % tabs.length
            : event.key === 'ArrowLeft'
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : -1;
        if (next < 0) return;
        event.preventDefault();
        select(next, true);
      });
    });

    list.hidden = false;
    root.classList.add('ready');
    select(0, false);
    openForHash();
    window.addEventListener('hashchange', openForHash);
  }
</script>

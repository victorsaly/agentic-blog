---
// Why: the studio's areas are separate pages, and this row is how Victor moves between them. It is drawn
// like a post's tabs (ruled cells, the open one filled black) so the studio reads as the same site, but each
// cell is a plain link: every area has its own address, so it works without script, can be bookmarked and
// linked to, and the keyboard simply tabs along it. The open one says so with aria-current. Nothing moves
// when an area opens; this row is used many times a day. On a desk the areas sit in one row; on a phone they
// fold into two rows of four (the last cell widening to close the row), so every area stays in sight.
// An area with something waiting shows how many: the review count is known at build time; the comments are
// counted when the page opens, and again whenever a decision on one is made, since readers write any time.
import { studioAreas, type StudioAreaId } from '../lib/studio-areas';

interface Props {
  current: StudioAreaId;
  /** Things waiting in an area, known at build time. */
  counts?: Partial<Record<StudioAreaId, number>>;
}

const { current, counts = {} } = Astro.props;
// Only these areas count what waits; comments arrive after the build, so theirs is filled in by the script.
const counted: readonly StudioAreaId[] = ['review', 'comments'];

// Line icons in the text colour, so they invert with it on the open cell.
const icons: Record<StudioAreaId, string> = {
  today: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  talk: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>',
  feedback: '<path d="M4 5h16v11H9l-5 4z"/><path d="M14 8l-3 2.5 3 2.5"/><path d="M11 10.5h5"/>',
  review: '<rect x="4" y="4" width="16" height="16"/><path d="m8 12 3 3 5-6"/>',
  comments: '<path d="M3 4h12v9H7l-4 3z"/><path d="M18 8h3v11l-4-3h-6v-3"/>',
  agents:
    '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>',
  runs: '<path d="M4 20h16"/><path d="M6 20v-6"/><path d="M11 20V9"/><path d="M16 20V5"/>',
};
---

<nav class="studio-tabs" aria-label="Studio">
  <ul>
    {
      studioAreas.map((area) => (
        <li>
          <a href={area.href} aria-current={area.id === current ? 'page' : undefined}>
            <svg
              class="icon"
              aria-hidden="true"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              set:html={icons[area.id]}
            />
            <span class="name">{area.name}</span>
            {counted.includes(area.id) && (
              <span class="count" data-count={area.id} hidden={!counts[area.id]}>
                <span class="n">{counts[area.id] ?? 0}</span>
                <span class="visually-hidden"> waiting</span>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { COMMENTS_CHANGED } from '../lib/studio-areas';

  const badge = document.querySelector<HTMLElement>('.studio-tabs [data-count="comments"]');
  const number = badge?.querySelector('.n');

  async function countComments(): Promise<void> {
    if (!badge || !number) return;
    try {
      const response = await fetch('/api/comments/count');
      const data: unknown = await response.json();
      const pending =
        typeof data === 'object' && data !== null ? (data as { pending?: unknown }).pending : null;
      if (!response.ok || typeof pending !== 'number') return;
      number.textContent = String(pending);
      badge.hidden = pending === 0;
    } catch {
      /* no count is better than a wrong one: the area itself says what failed */
    }
  }

  void countComments();
  window.addEventListener(COMMENTS_CHANGED, () => void countComments());
</script>

<style>
  .studio-tabs {
    margin: 0 0 var(--space-5);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  /* The hairlines between cells are the list's own ink showing through a one-pixel gap. */
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--rule-width);
    background: var(--ink);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  /* Seven areas in rows of four: the last one takes the empty place beside it. */
  li:last-child:nth-child(4n + 3) {
    grid-column: span 2;
  }
  @media (min-width: 48rem) {
    ul {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    li:last-child:nth-child(4n + 3) {
      grid-column: auto;
    }
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    height: 100%;
    min-height: 4rem;
    padding: var(--space-2) var(--space-1);
    background: var(--paper);
    color: var(--ink);
    font-size: var(--size-small);
    text-align: center;
    text-decoration: none;
    transition: scale var(--duration-press) var(--ease-out);
  }
  @media (min-width: 48rem) {
    a {
      flex-direction: row;
      gap: var(--space-2);
      min-height: 3.5rem;
      padding: 0 var(--space-3);
      font-size: var(--size-body);
    }
  }
  a:focus-visible {
    outline: var(--focus);
    outline-offset: calc(var(--focus-offset) * -2);
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      background: var(--hover);
    }
  }
  a:active {
    scale: 0.98;
  }
  a[aria-current='page'],
  a[aria-current='page']:hover {
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  a[aria-current='page']:focus-visible {
    outline-color: var(--paper);
  }
  .icon {
    flex: none;
  }
  /* How many wait: a number in a hairline box, drawn in the cell's own ink so it inverts with it. */
  .count:not([hidden]) {
    position: absolute;
    top: var(--space-1);
    right: var(--space-1);
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    padding: 0 0.3em;
    border: var(--rule-width) solid currentColor;
    font-size: var(--size-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }
  /* On a phone the cell is narrow, so the number sits in its corner; on a desk it follows the name. */
  @media (min-width: 48rem) {
    .count:not([hidden]) {
      position: static;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>

---
// Why: the whole idea in one control. A post is the AI version of a note; the note itself, the original, is
// kept as written. Two links side by side, the one you are reading filled, so the way to the original is
// never more than one click and a reader always knows which of the two they are on.
import { Image } from 'astro:assets';
import ideaIcon from '../assets/icons/idea.png';
import originIcon from '../assets/icons/origin.png';
import { formatDate } from '../lib/content';
import { settings } from '../lib/settings';

interface Props {
  slug: string;
  current: 'ai' | 'original';
  /** How the note came in and when, for the line beside the switch. */
  medium?: 'voice' | 'text' | undefined;
  recorded?: Date | undefined;
}

const { slug, current, medium, recorded } = Astro.props;
const note = medium === 'voice' ? 'a voice note' : 'a text note';
const how = medium === 'voice' ? 'recorded' : 'wrote';
const when = recorded ? ` on ${formatDate(recorded)}` : '';
const of = recorded ? ` of ${formatDate(recorded)}` : '';
---

<div class="version" data-pagefind-ignore>
  <nav class="switch" aria-label="Which version">
    <a href={`/thoughts/${slug}`} aria-current={current === 'ai' ? 'page' : undefined}>
      <Image src={ideaIcon} alt="" width={20} height={20} />
      AI version
    </a>
    <a href={`/thoughts/${slug}/origin`} aria-current={current === 'original' ? 'page' : undefined}>
      <Image src={originIcon} alt="" width={20} height={20} />
      Original
    </a>
  </nav>
  <p class="small quiet">
    {
      current === 'ai'
        ? `${settings.site.author}'s own thought, from ${note}${of}, tidied and structured with AI. The original is kept as written.`
        : `${settings.site.author} ${how} this${when}, and it is kept exactly as it came out. AI has not touched it.`
    }
  </p>
</div>

<style>
  .version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--rule-width) solid var(--ink);
  }
  /* Set a little crooked, like a stamp pressed by hand. */
  .switch {
    display: inline-flex;
    border: 2px solid var(--ink);
    rotate: -1.5deg;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .switch a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    text-decoration: none;
    background: var(--paper);
    color: var(--ink);
  }
  .switch a + a {
    border-left: 2px solid var(--ink);
  }
  .switch a:hover {
    text-decoration: underline;
  }
  .switch a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
  .switch :global(img) {
    width: 20px;
    height: 20px;
    filter: var(--drawing-filter);
    mix-blend-mode: var(--drawing-blend);
  }
  .switch a[aria-current='page'] :global(img) {
    filter: var(--drawing-filter-on-ink);
    mix-blend-mode: var(--drawing-blend-on-ink);
  }
  p {
    margin: 0;
    flex: 1 1 18rem;
  }
</style>

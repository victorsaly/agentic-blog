---
// Why: on a phone the side column falls below every post, so a reader who wants to narrow the list would
// have to scroll past all of it first. This strip puts the topics under the page heading instead, one ruled
// row like the home page's band, and only once the side column has dropped (base.css, .when-stacked); on a
// desk the side column does the same job.
import type { CollectionEntry } from 'astro:content';
import TopicLink from './TopicLink.astro';
import { themeCounts } from '../lib/themes';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
  current?: string;
}

const { thoughts, current } = Astro.props;
const counts = themeCounts(thoughts.map((t) => t.data.themes));
---

{
  counts.length > 0 && (
    <nav class="frame strip when-stacked" aria-label="Topics">
      <ul>
        {counts.map(([topic, count]) => (
          <li>
            <TopicLink topic={topic} count={count} current={current} />
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .strip {
    margin-top: var(--space-4);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    border-bottom: var(--rule-width) solid var(--ink);
  }
  ul :global(a) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding-right: var(--space-4);
    text-decoration: none;
  }
  ul :global(a:hover) {
    text-decoration: underline;
  }
  ul :global(a[aria-current='page']) {
    font-weight: 700;
  }
</style>

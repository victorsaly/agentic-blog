---
// Why: on a phone the side column falls below every post, so a reader who wants to narrow the list would
// have to scroll past all of it first. This strip puts the topics under the page heading instead, one ruled
// row like the home page's band, and only on narrow screens; on a desk the side column does the same job.
import type { CollectionEntry } from 'astro:content';
import { themeCounts } from '../lib/themes';
import { topicName } from '../lib/topic-name';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
  current?: string;
}

const { thoughts, current } = Astro.props;
const counts = themeCounts(thoughts.map((t) => t.data.themes));
---

{
  counts.length > 0 && (
    <nav class="frame strip" aria-label="Topics">
      <ul>
        {counts.map(([topic, count]) => (
          <li>
            <a href={`/topics/${topic}`} aria-current={current === topic ? 'page' : undefined}>
              {topicName(topic)}
              <span class="quiet">
                {count}
                <span class="visually-hidden">{count === 1 ? ' thought' : ' thoughts'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .strip {
    display: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    border-bottom: var(--rule-width) solid var(--ink);
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding-right: var(--space-4);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  a[aria-current='page'] {
    font-weight: 700;
  }
  /* The same width at which the list pages drop their side column. */
  @media (max-width: 61rem) {
    .strip {
      display: block;
      margin-top: var(--space-4);
    }
  }
</style>

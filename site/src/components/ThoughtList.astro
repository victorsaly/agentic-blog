---
// Why: the home page, theme pages and the archive list thoughts the same way: the post's linocut cover as a
// small print, the title as the one marigold mark, then the message in plain ink, the date and its
// themes. Spacing and rules only, no cards, so the list reads like a wall of prints with captions.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, thoughtSlugOf } from '../lib/content';
import { coversBySlug } from '../lib/covers';
import { themeLabel } from '../lib/themes';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
}

const { thoughts } = Astro.props;
const covers = await coversBySlug();
---

<ol class="thoughts">
  {
    thoughts.map((t) => {
      const slug = thoughtSlugOf(t.id);
      const cover = covers.get(slug);
      return (
        <li class:list={{ 'has-cover': cover }}>
          {cover && (
            <a class="print" href={`/thoughts/${slug}`} tabindex="-1" aria-hidden="true">
              <Image
                class="drawing"
                src={cover.image}
                alt=""
                width={240}
                height={240}
                loading="lazy"
              />
            </a>
          )}
          <div class="text">
            <h2 class="title">
              <a href={`/thoughts/${slug}`}>
                <mark>{t.data.title}</mark>
              </a>
            </h2>
            <p class="summary">{t.data.message}</p>
            <p class="small quiet meta">
              <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
              <span>{t.data.themes.map(themeLabel).join(', ')}</span>
            </p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .thoughts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    padding: var(--space-4) 0;
  }
  li + li {
    border-top: var(--rule-width) solid var(--rule);
  }
  li.has-cover {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  .print {
    display: block;
  }
  .print :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: var(--drawing-filter);
  }
  .title {
    font-size: var(--size-message);
    line-height: 1.25;
    margin: 0 0 var(--space-2);
  }
  .title a {
    text-decoration: none;
  }
  /* The same marigold as the message on a post, never the browser's default highlight. */
  .title mark {
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0.1em 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .title a:hover mark,
  .title a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.12em;
  }
  .summary {
    margin: 0 0 var(--space-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
  }
  @media (max-width: 30rem) {
    li.has-cover {
      grid-template-columns: 5rem 1fr;
      gap: var(--space-2);
    }
  }
</style>

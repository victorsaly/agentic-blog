---
// Why: a topic page lists its thoughts with their prints: the post's linocut cover as a small print, the
// title as the one marigold mark, then the message in plain ink, the date, and its other topics as links,
// so a reader can step sideways. Spacing and ink rules only, no cards: a wall of prints with captions.
// On a phone the print sits above its caption, so the message keeps a readable line.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, thoughtSlugOf } from '../lib/content';
import { coversBySlug } from '../lib/covers';
import { themeLabel } from '../lib/themes';

interface Props {
  thoughts: CollectionEntry<'thoughts'>[];
  /** The topic page this list is on: left out of each post's topic links, since you are there. */
  current?: string;
}

const { thoughts, current } = Astro.props;
const covers = await coversBySlug();
---

<ol class="thoughts">
  {
    thoughts.map((t) => {
      const slug = thoughtSlugOf(t.id);
      const cover = covers.get(slug);
      const others = t.data.themes.filter((topic) => topic !== current);
      return (
        <li class:list={{ 'has-cover': cover }}>
          {cover && (
            <a class="print" href={`/thoughts/${slug}`} tabindex="-1" aria-hidden="true">
              <Image
                class="drawing"
                src={cover.image}
                alt=""
                width={240}
                height={240}
                loading="lazy"
              />
            </a>
          )}
          <div class="text">
            <h3 class="title">
              <a href={`/thoughts/${slug}`}>
                <mark>{t.data.title}</mark>
              </a>
            </h3>
            <p class="summary">{t.data.message}</p>
            <p class="small quiet meta">
              <time datetime={t.data.date.toISOString()}>{formatDate(t.data.date)}</time>
              {others.length > 0 && (
                <span>
                  {current ? 'Also in ' : 'In '}
                  {others.map((topic, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/topics/${topic}`}>{themeLabel(topic)}</a>
                    </>
                  ))}
                </span>
              )}
            </p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* The list fills its column on a wide page; the message under each title keeps the reading measure. */
  .thoughts {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
  }
  li {
    padding: var(--space-4) 0;
  }
  li + li {
    border-top: var(--rule-width) solid var(--ink);
  }
  li.has-cover {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  .print {
    display: block;
  }
  .print :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--print-paper);
    padding: var(--print-pad);
    filter: var(--print-filter);
  }
  .title {
    font-size: var(--size-message);
    line-height: 1.25;
    margin: 0 0 var(--space-2);
  }
  .title a {
    text-decoration: none;
  }
  /* The same marigold as the message on a post, never the browser's default highlight. */
  .title mark {
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0.1em 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .title a:hover mark,
  .title a:focus-visible mark {
    text-decoration: underline;
    text-decoration-thickness: 0.12em;
  }
  .summary {
    margin: 0 0 var(--space-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
  }
  @media (min-width: 60rem) {
    li {
      padding-block: var(--space-5);
    }
    li.has-cover {
      grid-template-columns: 13rem 1fr;
      gap: var(--space-5);
    }
    .title {
      font-size: 1.75rem;
    }
  }
  @media (max-width: 30rem) {
    li.has-cover {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .print {
      width: 10rem;
    }
  }
</style>

---
// Why: the picture half of /graph. It draws a layout the page has already computed: the mark in the middle,
// each topic as an arc in the strong rule weight with its name outside, each small idea as a dot, and the
// hairlines between them. It is hidden from screen readers and from the tab order because the list beside
// it says the same thing in words; a pointer can still use it, a topic to open its ideas, a dot to find its
// idea in the list. Strokes keep their weight at any size, so the rules match the rest of the page.
import markRaw from '../assets/logo/mark.svg?raw';
import type { GraphLayout } from '../lib/graph-layout';

interface Props {
  layout: GraphLayout;
  /** Two pictures share the page (desk and phone), so each needs its own id for the mark's mask. */
  id: string;
  /** Where each idea is in the list: the first topic it is listed under. */
  anchors: Map<string, string>;
  texts: Map<string, string>;
  name: string;
  class?: string;
}

const { layout, id, anchors, texts, name, class: className } = Astro.props;
const o = layout.options;

// The mark is drawn in currentColor; its mask gets an id of this picture's own.
const markInner = markRaw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replaceAll('agentic-blog-hollow', `${id}-hollow`);
const markWidth = o.coreRadius * 1.3;
const markHeight = (markWidth * 414) / 563;
const showName = o.coreRadius > 60;
const markY = showName ? -markHeight * 0.75 : -markHeight / 2;
---

<svg
  class:list={['graph-picture', className]}
  viewBox={layout.viewBox}
  aria-hidden="true"
  focusable="false"
>
  <g class="edges">
    {
      layout.edges.map((e) => (
        <path
          d={e.d}
          data-t={e.topics.join(' ')}
          data-p={e.post}
          class={e.spoke ? 'spoke' : undefined}
        />
      ))
    }
  </g>
  <g class="topics">
    {
      layout.topics.map((t) => (
        <a href={`#t-${t.topic}`} tabindex="-1" data-topic={t.topic} data-t={t.topic}>
          <path class="hit" d={t.arc} />
          <path class="arc" d={t.arc} />
          <path class="leader" d={t.leader} />
          <text text-anchor={t.anchor} font-size={o.fontSize}>
            {t.lines.map((line, i) => (
              <tspan
                x={t.anchor === 'start' ? t.box.x0 : t.anchor === 'end' ? t.box.x1 : t.x}
                y={t.baselines[i]}
              >
                {line}
              </tspan>
            ))}
          </text>
        </a>
      ))
    }
  </g>
  <g class="ideas">
    {
      layout.ideas.map((i) => (
        <a
          href={`#${anchors.get(i.id) ?? ''}`}
          tabindex="-1"
          data-t={i.topics.join(' ')}
          data-p={i.post}
          data-idea={i.id}
        >
          {i.tip === undefined && <title>{texts.get(i.id)}</title>}
          <circle class="hit" cx={i.x} cy={i.y} r={o.dot * 2.6} />
          <circle cx={i.x} cy={i.y} r={o.dot} />
        </a>
      ))
    }
  </g>
  <a class="core" href="/how-it-works" tabindex="-1">
    <title>{name}: how this blog is made</title>
    <svg
      x={-markWidth / 2}
      y={markY}
      width={markWidth}
      height={markHeight}
      viewBox="0 0 563 414"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={markInner}
    />
    {
      showName && (
        <text
          text-anchor="middle"
          y={markY + markHeight + o.fontSize * 1.1}
          font-size={o.fontSize * 0.8}
        >
          {name}
        </text>
      )
    }
  </a>
  <g class="tips">
    {
      layout.ideas.map(
        (i) =>
          i.tip && (
            <text data-for={i.id} text-anchor="middle">
              {i.tip.lines.map((line, n) => (
                <tspan x="0" y={i.tip?.baselines[n]} font-size={o.tipSize}>
                  {line}
                </tspan>
              ))}
              {i.tip.from.map((line, n) => (
                <tspan class="from" x="0" y={i.tip?.fromBaselines[n]} font-size={o.tipSize * 0.75}>
                  {line}
                </tspan>
              ))}
            </text>
          ),
      )
    }
  </g>
</svg>

<style>
  .graph-picture {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--ink);
    font-family: var(--font);
    font-weight: 700;
  }
  .edges path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .arc {
    fill: none;
    stroke: var(--ink);
    stroke-width: var(--rule-strong);
    vector-effect: non-scaling-stroke;
  }
  .hit {
    fill: transparent;
    stroke: transparent;
    stroke-width: 28px;
    vector-effect: non-scaling-stroke;
  }
  .leader {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  /* The name sits on a paper halo so a line passing behind it never cuts a letter. */
  text {
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 0.45em;
    stroke-linejoin: round;
  }
  .ideas circle:not(.hit) {
    fill: var(--ink);
  }
  .ideas .hit {
    stroke: none;
  }
  /* An idea's words take the middle while a pointer rests on its dot; the mark steps aside for them. */
  .tips text {
    visibility: hidden;
    pointer-events: none;
  }
  .tips .from {
    fill: var(--quiet);
    font-weight: 400;
  }
  .ideas circle:not(.hit) {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (hover: hover) and (pointer: fine) {
    .graph-picture:has(.ideas a:hover) .core,
    .graph-picture:has(.ideas a:hover) .spoke {
      visibility: hidden;
    }
    .ideas a:hover circle:not(.hit) {
      transform: scale(1.8);
    }
  }
  .core text {
    letter-spacing: -0.01em;
  }
  /* The site underlines its links; in the picture a name is already a target, so the line only crowds it. */
  a {
    cursor: pointer;
    text-decoration: none;
  }
</style>

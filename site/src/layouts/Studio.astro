---
// Why: every studio page is the same private room with a different job in it. This layout gives them the
// room's own slim header (not the reader's), the row of areas, and keeps each page out of search engines, so
// a page only adds what its job needs. It uses the site's full frame: the studio is a workroom, not something
// to read. Cloudflare Access sits in front of /studio and everything under it, and /api/*.
import Page from './Page.astro';
import StudioTabs from '../components/StudioTabs.astro';
import { areaFor, studioAreas } from '../lib/studio-areas';
import { loadWaiting } from '../lib/studio-data';

interface Props {
  description: string;
}

const { description } = Astro.props;
const current = areaFor(Astro.url.pathname);
const area = studioAreas.find((a) => a.id === current);
const reviewWaiting = (await loadWaiting()).reduce((sum, t) => sum + t.waiting.length, 0);
const title = current === 'today' || !area ? 'Studio' : `${area.name} · Studio`;
---

<Page title={title} description={description} noindex={true} width="wide" room="studio">
  <div class="frame studio">
    <StudioTabs current={current} counts={{ review: reviewWaiting }} />
    <slot />
  </div>
</Page>

<style>
  /* The studio is a workroom, not a page to read: it takes the whole frame. Prose still keeps its measure. */
  .studio {
    padding-block: var(--space-4) var(--space-6);
  }
</style>

<style is:global>
  /* The recorder shows on two areas (a new origin, and talking back), so its look lives with the room. */
  .recorder {
    margin: var(--space-4) 0 var(--space-6);
  }
  /* The one big action, the same wherever it is: a filled ink button with the microphone, full width. */
  .say-it {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    min-height: calc(var(--tap) * 3);
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--size-message);
    font-weight: 700;
    text-decoration: none;
    transition: scale var(--duration-press) var(--ease-out);
  }
  .say-it:hover {
    background: var(--ink);
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .say-it:active {
    scale: 0.98;
  }
  .say-it:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  @media (prefers-reduced-motion: reduce) {
    .say-it {
      transition: none;
    }
  }
  .recorder .alternative {
    margin-top: var(--space-2);
  }
  /* How loud the microphone hears: a hairline track with an ink line stretched from the left. It moves only
     while recording, which Victor asked for by pressing Say it; it is information, not decoration. */
  .recorder .level {
    display: block;
    height: 6px;
    margin: 0 0 var(--space-3);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .recorder .level span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* Discard sits away from the main action, so a thumb does not find it by mistake. */
  .recorder .discard {
    margin-left: auto;
  }
  .recorder .done,
  .recorder .failed {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .recorder .done p,
  .recorder .failed p {
    margin: 0;
  }
  .recorder .elapsed {
    font-size: var(--size-title);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--space-3);
  }
  .recorder .transcript {
    white-space: pre-wrap;
  }
  .recorder .elapsed .paused {
    font-size: var(--size-body);
    color: var(--quiet);
  }
  .recorder .controls {
    margin-top: var(--space-2);
  }
  /* The words as they are heard: what Nova-3 is sure of in ink, its guess at what is being said now quieter. */
  .recorder .live-words {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: var(--rule-width) solid var(--rule);
  }
  .recorder .live-words p {
    margin: 0 0 var(--space-2);
  }
  .recorder .live-words .guess {
    color: var(--quiet);
  }
  .recorder .take {
    margin: var(--space-3) 0;
  }
  .recorder .take p {
    margin: 0 0 var(--space-1);
  }
  .recorder .take audio {
    width: 100%;
    max-width: var(--measure);
  }
  .recorder .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .recorder form .field + p {
    margin-top: var(--space-2);
  }
  .recorder form .row {
    margin-top: var(--space-3);
  }

  /* The live lists of the Agents area and a run's own page: a summary line, then rows with a state box. */
  .agents-live .summary {
    font-size: var(--size-message);
    font-weight: 700;
    margin: 0 0 var(--space-4);
  }
  .agents-live section + section,
  .pipeline {
    margin-top: var(--space-5);
  }
  .runs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .runs-list > li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  @media (max-width: 40rem) {
    .runs-list > li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .runs-list .what {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  .runs-list .what {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    min-width: 0;
  }
  .runs-list .links {
    display: flex;
    gap: var(--space-3);
  }
  /* A state is a word in a hairline box: filled while it is going, like a control that is on; a heavier rule
     where something stopped; quiet where nothing has happened yet, or a run has gone silent. The same marks
     in every list, the grid and a run's page. */
  .studio .state {
    justify-self: start;
    padding: 0 var(--space-2);
    border: var(--rule-width) solid var(--ink);
    font-size: var(--size-small);
    font-weight: 700;
    line-height: 1.6;
    white-space: nowrap;
  }
  .studio .state-running,
  .studio .state-needs-you {
    background: var(--ink);
    color: var(--paper);
  }
  .studio .state-held,
  .studio .state-failed {
    border-width: var(--rule-strong);
  }
  .studio .state-untouched,
  .studio .state-quiet {
    border-color: var(--rule);
    color: var(--quiet);
    font-weight: 400;
  }

  /* Markdown read in the studio (an agent's file, an answer before it is sent) reads like the site: the
     measure, hairlines between table rows, a strong rule beside a quote. Never decoration. */
  /* Words keep the reading measure; a table takes the room it needs, so its columns are not squeezed. */
  .studio .markdown > * {
    max-width: var(--measure);
  }
  .studio .markdown > .markdown-table {
    max-width: 100%;
  }
  .studio .markdown > :first-child {
    margin-top: 0;
  }
  .studio .markdown h2,
  .studio .markdown h3,
  .studio .markdown h4 {
    font-size: var(--size-body);
    margin: var(--space-4) 0 var(--space-2);
  }
  .studio .markdown blockquote {
    margin: var(--space-3) 0;
    padding-left: var(--space-3);
    border-left: var(--rule-strong) solid var(--ink);
  }
  /* A fenced block keeps every space, so a diagram drawn in text stays aligned; it scrolls, never wraps. */
  .studio .markdown pre {
    overflow-x: auto;
    max-width: 100%;
    padding: var(--space-2) 0;
    font-size: var(--size-small);
    line-height: 1.4;
  }
  .studio .markdown pre:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  .studio .markdown-table {
    overflow-x: auto;
    max-width: 100%;
  }
  .studio .markdown-table:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  .studio .markdown table {
    width: 100%;
    max-width: none;
    border-collapse: collapse;
    font-size: var(--size-small);
  }
  .studio .markdown th,
  .studio .markdown td {
    padding: var(--space-1) var(--space-2);
    border-bottom: var(--rule-width) solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .studio .markdown thead th {
    border-bottom: var(--rule-strong) solid var(--ink);
  }
  .recorder .preview {
    padding: var(--space-3);
    border: var(--rule-width) solid var(--ink);
    max-width: var(--measure);
  }

  /* A thought's route: the workflow left to right, in the studio's ink. Every mark uses the tokens, so it
     follows the theme. Filled while a step works or waits on Victor, a strong rule where it held or failed,
     quiet where it has not run; a gate is round. On a phone the picture gives way to a numbered list. */
  .route-scroll {
    overflow-x: auto;
    margin: var(--space-3) 0 var(--space-2);
    padding-bottom: var(--space-2);
  }
  .route-scroll:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }
  .route-picture {
    display: block;
    max-width: none;
  }
  .route-line {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
  }
  .route-line.lit {
    stroke: var(--ink);
  }
  .route-step rect {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1;
  }
  .route-step text {
    fill: var(--ink);
    font-family: inherit;
  }
  .route-step .name {
    font-size: 14px;
    font-weight: 700;
  }
  .route-step .word {
    font-size: 12px;
  }
  .route-step rect,
  .route-step text,
  .route-line {
    transition:
      fill 200ms ease,
      stroke 200ms ease;
  }
  .route-step.state-needs-you rect {
    fill: var(--ink);
  }
  .route-step.state-needs-you text {
    fill: var(--paper);
  }
  /* Working now: marigold, the one colour, with an ink bar sweeping along its foot and ink flowing along
     the lines into it. Constant motion, so linear; only transforms and a dash offset move. */
  .route-step.state-running rect {
    fill: var(--mark);
    stroke: var(--mark-ink);
  }
  .route-step.state-running text {
    fill: var(--mark-ink);
  }
  .route-step.state-running rect.sweep {
    fill: var(--mark-ink);
    stroke: none;
    transform-box: fill-box;
    animation: route-sweep 1.4s linear infinite;
  }
  .route-line.band {
    stroke: var(--mark);
    stroke-width: 6;
  }
  .route-line.flow {
    stroke: var(--mark-ink);
    stroke-width: 2;
    stroke-dasharray: 6 6;
    animation: route-flow 0.8s linear infinite;
  }
  @keyframes route-sweep {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(300%);
    }
  }
  @keyframes route-flow {
    to {
      stroke-dashoffset: -12;
    }
  }
  .route-step.state-held rect,
  .route-step.state-failed rect {
    stroke-width: 3;
  }
  .route-step.state-not-run rect {
    stroke: var(--rule);
  }
  .route-step.state-not-run text {
    fill: var(--quiet);
  }
  .route-step rect.here {
    fill: var(--ink);
    stroke: none;
  }
  .route a:focus-visible rect:first-child {
    stroke-width: 3;
  }
  .route a:hover .name {
    text-decoration: underline;
  }
  .route-list {
    display: none;
    margin: var(--space-3) 0;
    padding-left: var(--space-5);
  }
  .studio .route-list .state-not-run {
    border-color: var(--rule);
    color: var(--quiet);
    font-weight: 400;
  }
  .route-list > li {
    padding-block: var(--space-1);
  }
  .route-list .state {
    margin-left: var(--space-2);
  }
  .route-list > li.here {
    font-weight: 700;
  }
  .studio .route-list .state-running {
    position: relative;
    overflow: hidden;
    background: var(--mark);
    color: var(--mark-ink);
    border-color: var(--mark-ink);
  }
  .studio .route-list .state-running::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 33%;
    height: 3px;
    background: var(--mark-ink);
    animation: route-sweep 1.4s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .route-step.state-running rect.sweep,
    .route-line.flow,
    .studio .route-list .state-running::after {
      animation: none;
    }
  }
  .route-key {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .route-scroll {
      display: none;
    }
    .route-list {
      display: block;
    }
  }
  .show-route {
    grid-column: 1 / -1;
  }
  .show-route > summary {
    cursor: pointer;
    font-size: var(--size-small);
    font-weight: 700;
  }
</style>

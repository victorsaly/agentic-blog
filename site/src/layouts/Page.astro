---
// Why: one layout for every page. It carries the fonts, the theme and font switches (restored before first
// paint so nothing flashes), the robots rule from settings.yml, what a search engine or a link preview reads
// (description, canonical, the share picture), the skip link, and on reader pages in a production build the
// cookieless Cloudflare Web Analytics beacon. Pages add only content.
import { join } from 'node:path';
import '../styles/base.css';
import { settings } from '../lib/settings';
import { cleanPath } from '../lib/meta';
import { shareCard, type ShareImage } from '../lib/social';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StudioHeader from '../components/StudioHeader.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Pages that must never be indexed, whatever the switch says (the studio). */
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** What a shared link shows; without one, the site's own card. */
  image?: ShareImage | undefined;
  /** On a post: its topics, as article:tag. */
  tags?: string[];
  /** Structured data for the page (a post's Article), written into the head as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  /** "measure" keeps the page in one reading column; "wide" lets it lay out its own columns. */
  width?: 'measure' | 'wide';
  /** On a post: its title, which the header shows once the page title has scrolled away. */
  reading?: string;
  /** "studio" swaps the reader's header and footer for the workroom's own slim header. */
  room?: 'reader' | 'studio';
}

const {
  title,
  description,
  lang = settings.languages.origin,
  noindex = false,
  type = 'website',
  publishedAt,
  image,
  tags = [],
  jsonLd,
  width = 'measure',
  reading,
  room = 'reader',
} = Astro.props;
// The address the page is served at: the build writes .html files, the site serves them without.
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const indexable = settings.publishing.index && !noindex;
// Counted: reader pages on the live site. Not counted: the studio, and local development.
const beaconToken =
  import.meta.env.PROD && room === 'reader' ? settings.analytics.cloudflare_token : null;
// A title that already leads with the name (the home page's) is not signed twice.
const fullTitle = title.startsWith(settings.site.name) ? title : `${title} — ${settings.site.name}`;
const share =
  image ??
  shareCard(
    'site',
    `${settings.site.name}: ${settings.site.tagline}`,
    join(process.cwd(), 'public'),
  );
const shareSrc = share ? new URL(share.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="author" content={settings.site.author} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {settings.site.linkedin && <link rel="me" href={settings.site.linkedin} />}
    <meta
      name="robots"
      content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'}
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.site.name} />
    {
      share && shareSrc && (
        <>
          <meta property="og:image" content={shareSrc} />
          <meta property="og:image:type" content={share.type} />
          <meta property="og:image:width" content={String(share.width)} />
          <meta property="og:image:height" content={String(share.height)} />
          <meta property="og:image:alt" content={share.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {
      share && shareSrc && (
        <>
          <meta name="twitter:image" content={shareSrc} />
          <meta name="twitter:image:alt" content={share.alt} />
        </>
      )
    }
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {
      type === 'article' && (
        <meta
          property="article:author"
          content={settings.site.linkedin ?? new URL('/', Astro.site).href}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd }).replaceAll(
            '<',
            '\\u003c',
          )}
        />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${settings.site.name}: every thought`}
      href="/rss.xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Lexend:wght@400;700&display=swap"
    />
    <script is:inline>
      // Restore the reader's font and theme choices before first paint. Stored per browser; failures are fine.
      // The js class lets the header fold its menu only when the script that opens it is running.
      document.documentElement.classList.add('js');
      try {
        const font = localStorage.getItem('font');
        if (font === 'switch') document.documentElement.dataset.font = 'switch';
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    {room === 'studio' ? <StudioHeader /> : <Header reading={reading} />}
    <main id="content" tabindex="-1" class={width}>
      <slot />
    </main>
    {room === 'reader' && <Footer />}
    <script is:inline>
      // A search result opens its page with the words to mark; Pagefind's highlighter marks them there.
      if (new URLSearchParams(location.search).has('highlight')) {
        import('/pagefind/pagefind-highlight.js')
          .then(() => {
            // eslint-disable-next-line no-undef
            new PagefindHighlight({ highlightParam: 'highlight' });
          })
          .catch(() => {
            /* not built yet (local development): nothing to mark */
          });
      }
    </script>
    {
      beaconToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100%;
    background: var(--paper);
    padding: var(--space-2) var(--space-3);
    border: var(--rule-width) solid var(--ink);
  }
  .skip:focus {
    top: var(--space-2);
    z-index: 1;
  }
</style>

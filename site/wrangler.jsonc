// Why: the site is a Worker with static assets (Cloudflare's current path; Pages is on its way out).
// Bindings: the audio bucket, Workers AI for transcription, the chat's rate limiter, and two secrets (the
// GitHub dispatch and the chat). The custom domain is claimed here, so DNS is created by the deploy, not by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-blog",
  "compatibility_date": "2026-10-01",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ask", "/comments/*"],
  },
  "routes": [{ "pattern": "blog.victorsaly.com", "custom_domain": true }],
  // Only the custom domain serves the site. workers.dev and preview URLs sit outside Cloudflare Access,
  // so leaving them on would show /studio to anyone.
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "agentic-blog-audio" }],
  "ai": { "binding": "AI" },
  // The reader chat's burst limit: five questions a minute per visitor, counted in Cloudflare's memory only.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Comments: three a minute per visitor, again in memory only.
    { "name": "COMMENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
  ],
  // Reader comments. The database exists already (created 2026-10-25, 0001_comments.sql applied), and its id
  // is pinned so the deploy token needs no D1 permission: without an id, wrangler looks the database up by
  // name on every deploy, and the token is refused. A new migration: `npx wrangler d1 migrations apply
  // COMMENTS_DB --remote`, run by hand with an account that can edit D1.
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "agentic-blog-comments",
      "database_id": "1f67a92b-840f-4d59-9d88-e948340cf317",
      "migrations_dir": "migrations",
    },
  ],
  // The Turnstile site key is public by design; the secret is not (see below).
  "vars": { "GITHUB_REPO": "victorsaly/agentic-blog", "TURNSTILE_SITE_KEY": "" },
  "observability": { "enabled": true },
  // Secrets: GITHUB_TOKEN (`npx wrangler secret put GITHUB_TOKEN`, fine-grained, contents: write, this repo
  // only), ANTHROPIC_API_KEY for the reader chat (a key with a spend limit set in the Anthropic console), and
  // TURNSTILE_SECRET for the comment form (from the Turnstile widget in the Cloudflare dashboard).
}

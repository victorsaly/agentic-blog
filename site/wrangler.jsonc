// Why: the site is a Worker with static assets (Cloudflare's current path; Pages is on its way out).
// Bindings: the audio bucket, Workers AI for transcription, the chat's rate limiter, and two secrets (the
// GitHub dispatch and the chat). The custom domain is claimed here, so DNS is created by the deploy, not by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-blog",
  "compatibility_date": "2026-10-01",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ask"]
  },
  "routes": [{ "pattern": "blog.victorsaly.com", "custom_domain": true }],
  // Only the custom domain serves the site. workers.dev and preview URLs sit outside Cloudflare Access,
  // so leaving them on would show /studio to anyone.
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "agentic-blog-audio" }],
  "ai": { "binding": "AI" },
  // The reader chat's burst limit: five questions a minute per visitor, counted in Cloudflare's memory only.
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "GITHUB_REPO": "victorsaly/agentic-blog" },
  "observability": { "enabled": true }
  // Secrets: GITHUB_TOKEN (`npx wrangler secret put GITHUB_TOKEN`, fine-grained, contents: write, this repo
  // only) and ANTHROPIC_API_KEY for the reader chat (a key with a spend limit set in the Anthropic console).
}

# Why: what `npm run worker:dev --workspace site` needs. Copy to .dev.vars and fill in; wrangler reads
# .dev.vars in dev and never deploys it.
DEV_SKIP_ACCESS=1
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
# Cloudflare's always-pass test secret; pair it with the test site key 1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

{
  "name": "@agentic-blog/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && wrangler pages functions build --outdir=./dist/_worker.js/ && echo _worker.js > dist/.assetsignore",
    "preview": "astro preview",
    "typecheck": "astro check",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:fresh": "rm -f .astro/data-store.json node_modules/.astro/data-store.json .astro/content-assets.mjs && astro dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@roadbook/core": "*",
    "astro": "^7.4.7",
    "mermaid": "12.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satteri": "^0.11.6",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "pagefind": "1.6.0",
    "wrangler": "^4.158.0"
  }
}
